---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import BackToTop from '../components/BackToTop.astro';
import { publicFileExists } from '../lib/public-file';
import { getSite } from '../lib/content';
import { personSchema, websiteSchema, webPageSchema, autoBreadcrumbs } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  onHome?: boolean;
  subpage?: boolean;
  bodyClass?: string;
  printChrome?: boolean;
  backToTop?: boolean;
  /** Extra JSON-LD nodes (FAQPage, BreadcrumbList, Service, …) merged into the
   *  sitewide @graph. Build them with the helpers in lib/schema.ts. */
  schema?: unknown[];
  /** Overrides the last breadcrumb label — use the real page title for
   *  detail routes whose slug isn't in the nav (case studies, posts). */
  breadcrumbLeaf?: string;
  /** Schema.org type for this page's WebPage node — e.g. "AboutPage",
   *  "ContactPage", "CollectionPage", "ProfilePage". */
  pageType?: string;
  /** Keeps a page out of the index without removing it from the site. */
  noindex?: boolean;
  /** Overrides the social card. Defaults to this route's card in /og/. */
  ogImage?: string;
  /** OpenGraph object type. "article" for posts, "website" for everything else. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  onHome = false,
  subpage = false,
  bodyClass = '',
  printChrome = false,
  backToTop = true,
  schema = [],
  breadcrumbLeaf,
  pageType = 'WebPage',
  noindex = false,
  ogImage,
  ogType = 'website',
} = Astro.props;

const site = await getSite();
const chromeClass = printChrome ? 'no-print' : '';
// Pages set their own SEO; Site Settings supplies the fallback.
const pageTitle = title || site.seo.title;
const pageDescription = description || site.seo.description;
const origin = (Astro.site ?? new URL(Astro.url.origin)).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// Every route gets its own social card from public/og/, generated by
// `npm run og` from this same content. The route → filename rule mirrors
// scripts/og-images.mts ("/work/halo" → "work-halo"). A route whose card
// hasn't been generated yet falls back to og/default.png rather than emitting
// a 404 image — same build-time fs check Placeholder.astro uses.
const ogSlug = Astro.url.pathname === '/'
  ? 'home'
  : Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-');
const ogCandidate = ogImage ?? `/og/${ogSlug}.png`;
const ogPath = publicFileExists(ogCandidate) ? ogCandidate : '/og/default.png';
const ogUrl = new URL(ogPath, Astro.site ?? Astro.url).href;

// One connected @graph per page rather than several loose <script> blocks —
// the nodes cross-reference by @id, so Google reads them as one entity.
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    personSchema(site, origin),
    websiteSchema(site, origin),
    webPageSchema(origin, canonical, pageTitle, pageDescription, pageType),
    autoBreadcrumbs(site, origin, Astro.url.pathname, breadcrumbLeaf),
    ...schema.filter(Boolean),
  ].filter(Boolean),
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Sharing cards. Each route has its own 1200×630 card in /og/,
         generated by `npm run og` from the same content the page renders. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />

    <!-- Type is self-hosted (src/styles/fonts.css). Preload only the two faces
         above the fold — the h1 and body copy — so they don't wait for the
         stylesheet to parse. Preloading more would compete with the LCP. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/geist-700-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-400-latin.woff2"
      crossorigin
    />
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link">{site.skipLinkLabel}</a>
    <div class={chromeClass}>
      <a href="/" class="brand-sig" aria-label={`${site.name} — home`}>{site.name}</a>
      {subpage && (
        <a href="/" class="back-home" aria-label="Back to home">
          <span aria-hidden="true">←</span> {site.backHomeLabel}
        </a>
      )}
      <Navbar site={site} onHome={onHome} subpage={subpage} />
    </div>

    <main id="main">
      <slot />
    </main>

    <div class={chromeClass}>
      <Footer site={site} />
    </div>

    <div class={chromeClass}>
      <WhatsApp site={site} />
    </div>

    {backToTop && <BackToTop />}

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
