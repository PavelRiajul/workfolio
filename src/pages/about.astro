---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { getAbout, getHome } from '../lib/content';

const about = await getAbout();
const home = await getHome();
const headingLines = about.heading.split('\n');
---
<Base title="About — Riajul Islam" description={about.leadParagraph} subpage={true}>
  <section class="section" style="padding-bottom:0;">
    <div style="max-width:var(--maxw);margin:0 auto;">
      <div class="eyebrow" data-reveal>— About Me</div>
      <div class="about-intro-grid">
        <div data-reveal>
          <h1>{headingLines.map((l, i) => (<>{l}{i < headingLines.length - 1 && <br />}</>))}</h1>
        </div>
        <div data-reveal>
          <p class="about-lead">{about.leadParagraph}</p>
          <p class="about-second">{about.secondParagraph}</p>
          <div class="itags">
            {about.tags.map((t) => <span class="itag">{t}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section data-reveal style="padding:40px 0 110px;">
    <div class="gallery">
      {about.gallery.map((cap) => (
        <figure>
          <div class="frame"><Placeholder label={cap} /></div>
          <figcaption>{cap}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="section section-bordered">
    <div class="split">
      <div data-reveal>
        <div class="eyebrow">— Outside the code</div>
        <h2 class="about-h2">{about.outsideTitle}</h2>
      </div>
      <div data-reveal style="align-self:center;">
        <p class="about-outside-body">{about.outsideBody}</p>
      </div>
    </div>
  </section>

  <section class="section section-bordered">
    <div style="max-width:var(--maxw);margin:0 auto;">
      <div data-reveal>
        <div class="eyebrow">— Me as a developer</div>
        <h2 class="about-h2">4 things that make me me.</h2>
      </div>
      <div class="trait-grid">
        {about.traits.map((t) => (
          <div class="trait-card" data-reveal>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How I work (the craft standards — moved here from Home) -->
  <section class="section section-bordered">
    <div class="shell" style="padding:0;">
      <div data-reveal>
        <div class="eyebrow">{home.approachEyebrow}</div>
        <h2 class="about-h2" style="max-width:640px;">{home.approachTitle}</h2>
        <p class="split-lede" style="max-width:520px;">{home.approachLede}</p>
      </div>
      <div class="appr-grid">
        {home.principles.map((p, i) => (
          <div class={`appr-card ${i === home.principles.length - 1 ? 'dark' : ''}`} data-reveal>
            <div class="appr-top"><h3>{p.title}</h3><span class="appr-num">{p.number}</span></div>
            {i === home.principles.length - 1
              ? <p>{p.body}</p>
              : <div class="appr-desc"><p>{p.body}</p></div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What I build (the full range — moved here from Home) -->
  <section class="section section-bordered">
    <div class="split">
      <div data-reveal>
        <div class="eyebrow">— What I build</div>
        <h2 class="about-h2">The full range.</h2>
        <p class="split-lede">AI products and fast MVPs are where most of my work lands lately, but I build across the stack. Most projects blend two or three. <a href="/services">See the services →</a></p>
      </div>
      <div data-reveal>
        {home.services.map((s, i) => (
          <details class="acc" open={i === 0}>
            <summary><span class="acc-label"><span class="acc-num">{s.number}</span><span class="acc-title">{s.title}</span></span><span class="acc-ic">+</span></summary>
            <p>{s.body}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta title={about.closingTitle} bordered={true} />
</Base>
