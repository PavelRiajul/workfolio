---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { getAbout, getHome } from '../lib/content';

const about = await getAbout();
const home = await getHome();
const headingLines = about.heading.split('\n');
const traitsTitle = about.traitsHeading.title.split('\n');
const buildTitle = about.buildHeading.title.split('\n');
---
<Base title={about.seo.title} description={about.seo.description} subpage={true} pageType="AboutPage">
  <section class="section section-flush-bottom">
    <div class="wrap">
      <div class="eyebrow" data-reveal>{about.eyebrow}</div>
      <div class="about-intro-grid">
        <div data-reveal>
          <h1>{headingLines.map((l, i) => (<>{l}{i < headingLines.length - 1 && <br />}</>))}</h1>
        </div>
        <div data-reveal>
          <p class="about-lead">{about.leadParagraph}</p>
          <p class="about-second">{about.secondParagraph}</p>
          <div class="itags">
            {about.tags.map((t) => <span class="itag">{t}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-bleed section-tight-top" data-reveal>
    <div class="gallery">
      {about.gallery.map((photo) => (
        <figure>
          <div class="frame">
            <Placeholder label={photo.caption} src={photo.src} alt={photo.alt} image={photo.image} />
          </div>
          <figcaption>{photo.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="section section-bordered">
    <div class="split">
      <div data-reveal>
        <div class="eyebrow">{about.outsideEyebrow}</div>
        <h2 class="about-h2">{about.outsideTitle}</h2>
      </div>
      <div class="self-center" data-reveal>
        <p class="about-outside-body">{about.outsideBody}</p>
      </div>
    </div>
  </section>

  <section class="section section-bordered">
    <div class="wrap">
      <div data-reveal>
        <div class="eyebrow">{about.traitsHeading.eyebrow}</div>
        <h2 class="about-h2">{traitsTitle.map((l, i) => (<>{l}{i < traitsTitle.length - 1 && <br />}</>))}</h2>
      </div>
      <div class="trait-grid">
        {about.traits.map((t) => (
          <div class="trait-card" data-reveal>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How I work (the craft standards — moved here from Home) -->
  <section class="section section-bordered">
    <div class="wrap">
      <div data-reveal>
        <div class="eyebrow">{home.approachEyebrow}</div>
        <h2 class="about-h2 measure-wide">{home.approachTitle}</h2>
        <p class="split-lede">{home.approachLede}</p>
      </div>
      <div class="appr-grid">
        {home.principles.map((p, i) => (
          <div class={`appr-card ${i === home.principles.length - 1 ? 'dark' : ''}`} data-reveal>
            <div class="appr-top"><h3>{p.title}</h3><span class="appr-num">{p.number}</span></div>
            {i === home.principles.length - 1
              ? <p>{p.body}</p>
              : <div class="appr-desc"><p>{p.body}</p></div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What I build (the full range — moved here from Home) -->
  <section class="section section-bordered">
    <div class="split">
      <div data-reveal>
        <div class="eyebrow">{about.buildHeading.eyebrow}</div>
        <h2 class="about-h2">{buildTitle.map((l, i) => (<>{l}{i < buildTitle.length - 1 && <br />}</>))}</h2>
        <p class="split-lede">{about.buildHeading.lede} <a href={about.buildLink.href}>{about.buildLink.label}</a> <a href={about.stackLink.href}>{about.stackLink.label}</a></p>
      </div>
      <div data-reveal>
        {home.services.map((s, i) => (
          <details class="acc" open={i === 0}>
            <summary><span class="acc-label"><span class="acc-num">{s.number}</span><span class="acc-title">{s.title}</span></span><span class="acc-ic">+</span></summary>
            <p>{s.body}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta title={about.closingTitle} bordered={true} />
</Base>
