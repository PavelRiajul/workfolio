---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { getAbout } from '../lib/content';

const about = await getAbout();
const headingLines = about.heading.split('\n');
---
<Base title="About — Riajul Islam" description={about.leadParagraph} subpage={true}>
  <section class="section" style="padding-bottom:0;">
    <div style="max-width:var(--maxw);margin:0 auto;">
      <div class="eyebrow" data-reveal>— About Me</div>
      <div class="about-intro-grid">
        <div data-reveal>
          <h1>{headingLines.map((l, i) => (<>{l}{i < headingLines.length - 1 && <br />}</>))}</h1>
        </div>
        <div data-reveal>
          <p class="about-lead">{about.leadParagraph}</p>
          <p class="about-second">{about.secondParagraph}</p>
          <div class="itags">
            {about.tags.map((t) => <span class="itag">{t}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section data-reveal style="padding:40px 0 110px;">
    <div class="gallery">
      {about.gallery.map((cap) => (
        <figure>
          <div class="frame"><Placeholder label={cap} /></div>
          <figcaption>{cap}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="section section-bordered">
    <div class="split">
      <div data-reveal>
        <div class="eyebrow">— Outside the code</div>
        <h2 class="about-h2">{about.outsideTitle}</h2>
      </div>
      <div data-reveal style="align-self:center;">
        <p class="about-outside-body">{about.outsideBody}</p>
      </div>
    </div>
  </section>

  <section class="section section-bordered">
    <div style="max-width:var(--maxw);margin:0 auto;">
      <div data-reveal>
        <div class="eyebrow">— Me as a developer</div>
        <h2 class="about-h2">4 things that make me me.</h2>
      </div>
      <div class="trait-grid">
        {about.traits.map((t) => (
          <div class="trait-card" data-reveal>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta title={about.closingTitle} bordered={true} />
</Base>
