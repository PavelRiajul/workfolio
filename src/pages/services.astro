---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import ClosingCta from '../components/ClosingCta.astro';
import OfferVisual from '../components/OfferVisual.astro';
import Faq from '../components/Faq.astro';
import { getSite, getHome, getServices, getServicesPage } from '../lib/content';
import { faqSchema, servicesSchema } from '../lib/schema';
import Headline from '../components/Headline.astro';

const site = await getSite();
const home = await getHome();
const services = await getServices();
const page = await getServicesPage();

// Blue is the house accent; the commerce row borrows the Shopify green,
// matching the rest of the commerce surfaces.
const accentFor = (visual: string) => (visual === 'commerce' ? '#5e8e3e' : 'var(--color-blue)');

const heroLines = page.hero.headlineLines;
const methodTitle = page.methodHeading.title.split('\n');
const listTitle = page.listHeading.title.split('\n');
const engagementsTitle = page.engagementsHeading.title.split('\n');
const processTitle = page.processHeading.title.split('\n');

const origin = (Astro.site ?? new URL(Astro.url.origin)).href;
const schema = [faqSchema(page.faqs), ...servicesSchema(services, site, origin)];
---
<Base
  title={page.seo.title}
  description={page.seo.description}
  subpage={true}
  pageType="CollectionPage"
  schema={schema}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-grid"></div>
    <div class="hero-inner shell" data-hero-intro>
      <div class="hero-meta" data-hero-item>
        <span>—</span>
        <span>{page.hero.eyebrow}</span>
        <span class="chip-open"><span class="dot"></span>{page.hero.chip}</span>
      </div>
      <h1 data-hero-item>
        <Headline text={heroLines} />
        {page.hero.accentWord && <> <span class="accent">{page.hero.accentWord}</span></>}
      </h1>
      <div class="hero-lower">
        <div class="hero-copy">
          <p class="hero-lede hero-lede-full" data-hero-item>{page.hero.lede}</p>
          {page.hero.ledeShort && <p class="hero-lede hero-lede-short" data-hero-item>{page.hero.ledeShort}</p>}
          <div class="hero-actions" data-hero-item>
            <a href={page.hero.primaryCta.href} class="btn btn-dark">{page.hero.primaryCta.label} <span>↗</span></a>
            <a href={page.hero.secondaryCta.href} class="btn btn-light">{page.hero.secondaryCta.label}</a>
          </div>
          <div class="hero-stats" data-hero-item>
            {page.hero.stats.map((s) => (
              <div>
                <div class="num">{s.value}</div>
                <div class="lbl">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="hero-visual velo-wrap" data-hero-item aria-hidden="true">
          <div class="velo" data-bars>
            <div class="velo-k">{page.velocity.kicker}</div>
            {page.velocity.rows.map((v) => (
              <div class={`velo-row ${v.muted ? 'muted' : ''}`}>
                <div class="velo-top"><span>{v.label}</span><b>{v.value}</b></div>
                <div class="velo-bar"><i class="bargrow" style={`width:${v.barWidth}`}></i></div>
              </div>
            ))}
            <div class="velo-foot"><Icon name="fa-solid fa-bolt" />{page.velocity.foot}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How the AI workflow actually runs -->
  <section class="section section-bordered">
    <div class="wrap">
      <div class="eyebrow" data-reveal>{page.methodHeading.eyebrow}</div>
      <h2 class="section-h2 measure-wide" data-reveal>
        <Headline text={methodTitle} />
      </h2>
      <div class="appr-grid">
        {home.aiWorkflow.map((a) => (
          <div class="appr-card" data-reveal>
            <div class="appr-top">
              <h3>{a.title}</h3>
              <span class="appr-num">{a.number}/0{home.aiWorkflow.length}</span>
            </div>
            <div class="appr-desc"><p>{a.body}</p></div>
          </div>
        ))}
      </div>
      <p class="ai-caveat" data-reveal>{home.aiCaveat}</p>
    </div>
  </section>

  <!-- The services -->
  <section id="svc-list" class="section section-bordered anchor">
    <div class="wrap">
      <div class="work-head" data-reveal>
        <div>
          <div class="eyebrow">{page.listHeading.eyebrow}</div>
          <h2 class="section-h2 measure">
            <Headline text={listTitle} />
          </h2>
        </div>
        <a href={page.listCta.href} class="btn btn-light btn-sm">{page.listCta.label}</a>
      </div>
      <p class="work-note" data-reveal>
        I start from a setup I already trust rather than picking tools from scratch each time.
        <a href={page.stackLink.href}>{page.stackLink.label}</a>
      </p>

      <div class="svc-showcase">
        {services.map((s, i) => (
          <div
            class={`svcf anchor-deep ${i % 2 === 1 ? 'rev' : ''}`}
            id={s.slug}
            style={`--acc:${accentFor(s.visual)};`}
            data-reveal
          >
            <div class={`svcf-media tone-${s.tone}`} aria-hidden="true">
              <span class="svcf-ghost" aria-hidden="true">{s.number}</span>
              <OfferVisual service={s} />
            </div>
            <div class="svcf-copy">
              <div class="svcf-top">
                <span class="svcf-tag"><Icon name={s.icon} /> {s.kicker}</span>
                <span class="svcf-no">{s.number} / 0{services.length}</span>
                <span class="svcf-time"><Icon name="fa-regular fa-clock" />{s.timeline}</span>
              </div>
              <h3>{s.title}</h3>
              <p>{s.description}</p>
              <details class="feats" open>
                <summary><span>{s.features.length} capabilities</span><i aria-hidden="true">+</i></summary>
                <ul class="svcf-feats">
                  {s.features.map((f) => <li><Icon name="fa-solid fa-check" />{f}</li>)}
                </ul>
              </details>
              <div class="svcf-ctas">
                <a class="svcf-cta" href={page.serviceCta.href}>{page.serviceCta.label} <span aria-hidden="true">↗</span></a>
                {s.href && (
                  <a class="svcf-cta ghost" href={s.href}>{page.serviceDeepLinkCta.label} <span aria-hidden="true">→</span></a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Engagement models -->
  <section class="section section-bordered">
    <div class="wrap">
      <div class="eyebrow" data-reveal>{page.engagementsHeading.eyebrow}</div>
      <h2 class="section-h2" data-reveal>
        <Headline text={engagementsTitle} />
      </h2>
      <div class="appr-grid eng-grid">
        {page.engagements.map((e) => (
          <div class="appr-card" data-reveal>
            <div class="appr-top">
              <h3>{e.title}</h3>
              <span class="appr-num">{e.number}/0{page.engagements.length}</span>
            </div>
            <div class="appr-desc">
              <p>{e.body}</p>
              <span class="eng-meta">{e.meta}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process — a timeline, so it reads differently to the FAQ below -->
  <section class="section process">
    <div class="wrap">
      <div data-reveal>
        <div class="eyebrow">{page.processHeading.eyebrow}</div>
        <h2 class="section-h2"><Headline text={processTitle} /></h2>
        <p class="split-lede">{page.processHeading.lede}</p>
      </div>
      <div class="cyc cyc-blue" data-reveal>
        {home.process.map((s) => (
          <div class="cyc-step">
            <div class="cyc-node">{s.number}</div>
            <div class="cyc-body"><h3>{s.title}</h3><p>{s.body}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <Faq
    eyebrow={page.faqHeading.eyebrow}
    title={page.faqHeading.title}
    items={page.faqs.map((f) => ({ q: f.question, a: f.answer }))}
  />

  <ClosingCta
    title={page.closing.title}
    bordered={true}
    primary={page.closing.primary}
    secondary={page.closing.secondary}
  />
</Base>
