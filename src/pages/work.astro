---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import ClosingCta from '../components/ClosingCta.astro';
import ProjectModal from '../components/ProjectModal.astro';
import { getProjects } from '../lib/content';

const projects = await getProjects();
const filters = [
  { label: 'All', value: 'all' },
  { label: 'AI', value: 'ai' },
  { label: 'Shopify', value: 'shopify' },
  { label: 'Next.js', value: 'nextjs' },
  { label: 'React Native', value: 'reactnative' },
  { label: 'MERN', value: 'mern' },
];
---
<Base title="Work — Riajul Islam" description="Selected products I've shipped — AI products and MVPs, headless Shopify, full-stack web apps and cross-platform mobile." subpage={true}>
  <section class="section" style="padding-top:clamp(72px,11vw,120px);padding-bottom:40px;">
    <div class="page-hero" data-reveal>
      <div class="eyebrow">— Selected Work</div>
      <h1>Everything I've<br>built, in one place.</h1>
      <p>A selection of products I've shipped — from AI MVPs and headless Shopify storefronts to full-stack web apps and cross-platform mobile. Each one built to make it ship.</p>
    </div>
  </section>

  <section class="section" style="padding-top:clamp(40px,7vw,64px);">
    <div style="max-width:var(--maxw);margin:0 auto;">
      <div class="filters" data-reveal style="margin-bottom:40px;">
        {filters.map((f, i) => (
          <button class={`chip ${i === 0 ? 'active' : ''}`} data-filter={f.value} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
        ))}
      </div>
      <div class="work-grid">
        {projects.map((p) => <WorkCard project={p} />)}
      </div>
    </div>
  </section>

  <ClosingCta title={"Like what you see?\nLet's build the next one."} />

  <ProjectModal projects={projects} />
</Base>

<script>
  // Project filter — Work page only.
  const chips = document.querySelectorAll<HTMLElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('.work-grid [data-tags]');
  if (chips.length && cards.length) {
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter;
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle('active', on);
          c.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        cards.forEach((card) => {
          const tags = (card.dataset.tags || '').split(',');
          const show = f === 'all' || (f && tags.includes(f));
          card.style.display = show ? '' : 'none';
        });
      });
    });
  }
</script>
