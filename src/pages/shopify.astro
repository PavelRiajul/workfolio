---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import ClosingCta from '../components/ClosingCta.astro';
import ServiceVisual from '../components/ServiceVisual.astro';
import CroDashboard from '../components/CroDashboard.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import { getProjects, getShopifyServices, getShopifyPage } from '../lib/content';
import { faqSchema, shopifyServicesSchema } from '../lib/schema';
import Headline from '../components/Headline.astro';

const projects = await getProjects();
const services = await getShopifyServices();
const page = await getShopifyPage();
const shopifyProjects = projects.filter((p) => p.tags.includes('shopify'));
const featured = shopifyProjects[0];

const heroLines = page.hero.headlineLines;
const brandsTitle = page.brandsHeading.title.split('\n');
const servicesTitle = page.servicesHeading.title.split('\n');
const approachTitle = page.approachHeading.title.split('\n');
const numbersTitle = page.numbersHeading.title.split('\n');
const croTitle = page.cro.heading.title.split('\n');
const leakTitle = page.leakHeading.title.split('\n');
const croProcessTitle = page.croProcessHeading.title.split('\n');
const calcTitle = page.calcHeading.title.split('\n');
const experimentsTitle = page.experimentsHeading.title.split('\n');
const featuredTitle = page.featuredHeading.title.split('\n');

const origin = (Astro.site ?? new URL(Astro.url.origin)).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const schema = [faqSchema(page.faqs), ...shopifyServicesSchema(services, origin, canonical)];
---
<Base
  title={page.seo.title}
  description={page.seo.description}
  subpage={true}
  pageType="CollectionPage"
  schema={schema}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-grid"></div>
    <div class="hero-inner shell" data-hero-intro>
      <div class="hero-meta" data-hero-item>
        <span>—</span>
        <span>{page.hero.eyebrow}</span>
        <span class="chip-open chip-shop"><span class="dot"></span>{page.hero.chip}</span>
      </div>
      <h1 data-hero-item>
        <Headline text={heroLines} />
        {page.hero.accentWord && <> <span class="accent accent-shop">{page.hero.accentWord}</span></>}
      </h1>
      <div class="hero-lower">
        <div class="hero-copy">
          <p class="hero-lede hero-lede-full" data-hero-item>{page.hero.lede}</p>
          {page.hero.ledeShort && <p class="hero-lede hero-lede-short" data-hero-item>{page.hero.ledeShort}</p>}
          <div class="hero-actions" data-hero-item>
            <a href={page.hero.primaryCta.href} class="btn btn-dark">{page.hero.primaryCta.label} <span>↗</span></a>
            <a href={page.hero.secondaryCta.href} class="btn btn-light">{page.hero.secondaryCta.label}</a>
          </div>
          <div class="hero-stats" data-hero-item>
            {page.hero.stats.map((s) => (
              <div>
                <div class="num">{s.value}</div>
                <div class="lbl">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="hero-visual" data-hero-item aria-hidden="true">
          <div class="hv-stage" id="hv-stage">
            <div class="hv-card sh-store"><div class="hv-inner">
              <div class="sh-store-top"><Icon name="fa-brands fa-shopify" /><span class="sh-dot-bar"></span><Icon name="fa-solid fa-bag-shopping" /></div>
              <div class="sh-banner"><span>SUMMER<br>DROP</span></div>
              <div class="sh-grid">
                <div class="sh-tile"><div class="sh-tile-img"></div><span class="sh-tile-price">$24</span></div>
                <div class="sh-tile"><div class="sh-tile-img"></div><span class="sh-tile-price">$39</span></div>
                <div class="sh-tile"><div class="sh-tile-img"></div><span class="sh-tile-price">$18</span></div>
              </div>
            </div></div>
            <div class="hv-card sh-stat"><div class="hv-inner">
              <div class="sh-stat-val">+24%</div>
              <div class="sh-stat-lbl">Conversion rate</div>
              <div class="sh-spark"><i style="height:32%"></i><i style="height:54%"></i><i style="height:46%"></i><i style="height:72%"></i><i style="height:90%"></i></div>
            </div></div>
            <div class="hv-card sh-cart"><div class="hv-inner">
              <div class="sh-cart-head"><Icon name="fa-solid fa-bag-shopping" /> Cart · 2</div>
              <div class="sh-cart-row"><span class="sh-line"></span><span>$24</span></div>
              <div class="sh-cart-row"><span class="sh-line"></span><span>$39</span></div>
              <div class="sh-cart-total"><span>Total</span><b>$63</b></div>
              <span class="sh-checkout">Checkout</span>
            </div></div>
            <div class="hv-card sh-badge"><div class="hv-inner"><Icon name="fa-brands fa-shopify" /></div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Brands -->
  <section class="section section-bordered">
    <div class="wrap">
      <div class="eyebrow" data-reveal>{page.brandsHeading.eyebrow}</div>
      <h2 class="section-h2 measure-wide" data-reveal>
        <Headline text={brandsTitle} />
      </h2>
      <div class="brand-wall" data-reveal>
        {page.brands.map((b) => <span>{b}</span>)}
      </div>
    </div>
  </section>

  <!-- Services showcase (alternating per-service feature rows) -->
  <section id="sh-services" class="section section-bordered anchor">
    <div class="wrap">
      <div class="work-head" data-reveal>
        <div>
          <div class="eyebrow">{page.servicesHeading.eyebrow}</div>
          <h2 class="section-h2 measure">
            <Headline text={servicesTitle} />
          </h2>
        </div>
        <a href={page.servicesCta.href} class="btn btn-light btn-sm">{page.servicesCta.label}</a>
      </div>

      <div class="svc-showcase">
        {services.map((s, i) => (
          <div class={`svcf ${i % 2 === 1 ? 'rev' : ''}`} data-reveal>
            <div class={`svcf-media tone-${s.tone}`} aria-hidden="true">
              <span class="svcf-ghost" aria-hidden="true">{s.number}</span>
              <ServiceVisual service={s} />
            </div>
            <div class="svcf-copy">
              <div class="svcf-top">
                <span class="svcf-tag"><Icon name="fa-brands fa-shopify" /> {page.serviceTagLabel}</span>
                <span class="svcf-no">{s.number} / 0{services.length}</span>
              </div>
              <h3>{s.title}</h3>
              <p>{s.description}</p>
              <details class="feats" open>
                <summary><span>{s.features.length} capabilities</span><i aria-hidden="true">+</i></summary>
                <ul class="svcf-feats">
                  {s.features.map((f) => <li><Icon name="fa-solid fa-check" />{f}</li>)}
                </ul>
              </details>
              <a class="svcf-cta" href={page.serviceCta.href}>{page.serviceCta.label} <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section section-bordered">
    <div class="wrap">
      <div class="eyebrow" data-reveal>{page.approachHeading.eyebrow}</div>
      <h2 class="section-h2" data-reveal>
        <Headline text={approachTitle} />
      </h2>
      <div class="appr-grid">
        {page.approach.map((a) => (
          <div class="appr-card" data-reveal>
            <div class="appr-top">
              <h3>{a.title}</h3>
              <span class="appr-num">{a.number}/0{page.approach.length}</span>
            </div>
            <div class="appr-desc"><p>{a.body}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Track record (dark) -->
  <section class="section process">
    <div class="wrap">
      <div class="eyebrow" data-reveal>{page.numbersHeading.eyebrow}</div>
      <h2 class="section-h2" data-reveal>
        <Headline text={numbersTitle} />
      </h2>
      <div class="cs-out-grid bento-5" data-reveal>
        {page.numbers.map((n) => (
          <div>
            <div class="stat" data-count={String(n.value)} data-prefix={n.prefix || ''} data-suffix={n.suffix || ''} data-decimals={String(n.decimals || 0)}>{(n.prefix || '') + '0' + (n.suffix || '')}</div>
            <div class="lbl">{n.label}</div>
          </div>
        ))}
      </div>
      <p class="cs-out-note" data-reveal>{page.numbersNote}</p>
    </div>
  </section>

  <!-- CRO — the second half of the service -->
  <section id="cro" class="section section-bordered cro-sec anchor">
    <div class="cro">
      <div class="cro-copy" data-reveal>
        <div class="eyebrow">{page.cro.heading.eyebrow}</div>
        <h2 class="section-h2"><Headline text={croTitle} /></h2>
        <p class="cro-lede">{page.cro.lede}</p>
        <div class="cro-pills">
          {page.cro.features.map((f) => (
            <span class="cro-pill"><Icon name="fa-solid fa-check" />{f}</span>
          ))}
        </div>
        <div class="cro-actions">
          <a href={page.cro.primaryCta.href} class="btn btn-dark">{page.cro.primaryCta.label} <span>↗</span></a>
          <a href={page.cro.secondaryCta.href} class="btn btn-light">{page.cro.secondaryCta.label}</a>
        </div>
      </div>

      <div class="cro-viz" data-reveal data-bars aria-hidden="true">
        <CroDashboard data={page.croDashboard} />
      </div>
    </div>
  </section>

  <!-- Funnel leak + fixes -->
  <section class="section section-bordered">
    <div class="wrap">
      <div class="eyebrow" data-reveal>{page.leakHeading.eyebrow}</div>
      <h2 class="section-h2 measure-wide" data-reveal>
        <Headline text={leakTitle} />
      </h2>
      <div class="lf">
        <div class="leak" data-reveal>
          {page.funnel.map((f, i) => (
            <>
              {i > 0 && (
                <div class="leak-gap"><span class="leak-drop">{f.drop}</span><span class="leak-why">{f.why}</span></div>
              )}
              <div class="leak-stage" style={`--w:${f.width}`}>
                <span class="leak-name">{f.name}</span>
                <span class="leak-val" data-count={String(f.count)} data-sep="true">{f.count.toLocaleString('en-US')}</span>
              </div>
            </>
          ))}
        </div>
        <div class="fixes" data-reveal data-bars>
          {page.fixes.map((f) => (
            <div class="fix">
              <span class="fix-ic"><Icon name={`fa-solid ${f.icon}`} /></span>
              <div class="fix-body"><h3>{f.title}</h3><p>{f.body}</p></div>
              <div class="fix-impact"><span>Impact</span><div class="fix-bar"><i class="bargrow" style={`width:${f.barWidth}`}></i></div></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CRO loop (dark) -->
  <section id="cro-process" class="section process anchor">
    <div class="wrap">
      <div class="eyebrow" data-reveal>{page.croProcessHeading.eyebrow}</div>
      <h2 class="section-h2" data-reveal>
        <Headline text={croProcessTitle} />
      </h2>
      <div class="cyc" data-reveal>
        {page.croProcess.map((s) => (
          <div class="cyc-step">
            <div class="cyc-node">{s.number}</div>
            <div class="cyc-body"><h3>{s.title}</h3><p>{s.body}</p></div>
          </div>
        ))}
        <div class="cyc-loop"><Icon name="fa-solid fa-arrow-rotate-left" /> {page.croProcessLoopNote}</div>
      </div>
    </div>
  </section>

  <!-- Revenue calculator -->
  <section class="section section-bordered anchor">
    <div class="wrap">
      <div class="work-head" data-reveal>
        <div>
          <div class="eyebrow">{page.calcHeading.eyebrow}</div>
          <h2 class="section-h2"><Headline text={calcTitle} /></h2>
        </div>
        <a href={page.calcCta.href} class="btn btn-light btn-sm">{page.calcCta.label}</a>
      </div>
      <div class="calc" id="cro-calc" data-reveal>
        <div class="calc-controls">
          <label class="calc-field">
            <span class="calc-l">{page.calcLabels.visitors} <b id="cv-vis">20,000</b></span>
            <input class="calc-range" type="range" id="ci-vis" min="2000" max="200000" step="1000" value="20000" aria-label={page.calcLabels.visitors} />
          </label>
          <label class="calc-field">
            <span class="calc-l">{page.calcLabels.aov} <b id="cv-aov">$65</b></span>
            <input class="calc-range" type="range" id="ci-aov" min="15" max="400" step="5" value="65" aria-label={page.calcLabels.aov} />
          </label>
          <label class="calc-field">
            <span class="calc-l">{page.calcLabels.current} <b id="cv-cur">2.0%</b></span>
            <input class="calc-range" type="range" id="ci-cur" min="0.5" max="8" step="0.1" value="2.0" aria-label={page.calcLabels.current} />
          </label>
          <label class="calc-field">
            <span class="calc-l">{page.calcLabels.target} <b id="cv-tgt">3.0%</b></span>
            <input class="calc-range" type="range" id="ci-tgt" min="0.5" max="10" step="0.1" value="3.0" aria-label={page.calcLabels.target} />
          </label>
        </div>
        <div class="calc-out">
          <span class="calc-out-k">{page.calcLabels.outKicker}</span>
          <div class="calc-big" id="co-year">$0</div>
          <div class="calc-sub" id="co-sub">from a +1.0 pt conversion change</div>
          <div class="calc-rows">
            <div><span>{page.calcLabels.revenueNow}</span><b id="co-now">$0/mo</b></div>
            <div><span>{page.calcLabels.revenueAfter}</span><b id="co-after">$0/mo</b></div>
            <div class="up"><span>{page.calcLabels.monthlyUplift}</span><b id="co-mo">+$0</b></div>
            <div class="up"><span>{page.calcLabels.extraOrders}</span><b id="co-orders">0</b></div>
          </div>
        </div>
      </div>
      <p class="calc-note">{page.calcNote}</p>
    </div>
  </section>

  <!-- Experiments leaderboard -->
  <section class="section section-bordered">
    <div class="wrap">
      <div class="eyebrow" data-reveal>{page.experimentsHeading.eyebrow}</div>
      <h2 class="section-h2" data-reveal>
        <Headline text={experimentsTitle} />
      </h2>
      <div class="lead" data-reveal>
        <div class="lead-row lead-head">
          <span>#</span><span>{page.experimentsColumns.test}</span><span class="lead-metric">{page.experimentsColumns.metric}</span><span style="text-align:right;">{page.experimentsColumns.lift}</span>
        </div>
        <div class="lead-body">
          {page.experiments.map((e, i) => (
            <div class="lead-row">
              <span class="lead-rank">{String(i + 1).padStart(2, '0')}</span>
              <span class="lead-test">{e.title}<span>{e.area}</span></span>
              <span class="lead-metric">{e.metric}</span>
              <span class="lead-lift" data-count={String(e.lift)} data-prefix="+" data-suffix="%">+{e.lift}%</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Featured work -->
  {featured && (
    <section id="sh-work" class="section section-bordered anchor">
      <div class="wrap">
        <div class="work-head" data-reveal>
          <div>
            <div class="eyebrow">{page.featuredHeading.eyebrow}</div>
            <h2 class="section-h2">
              <Headline text={featuredTitle} />
            </h2>
          </div>
          <a href={page.featuredCta.href} class="btn btn-light btn-sm">{page.featuredCta.label}</a>
        </div>
        <a href={`/work/${featured.slug}`} class="post-feature stack-lg" data-reveal>
          <div class="cover"><Placeholder label={`${featured.title} — ${featured.type}`} image={featured.image} src={`/work/${featured.slug}.jpg`} /></div>
          <div class="pf-body">
            <div class="pf-meta">
              {featured.pills.map((p) => <span class="pf-badge">{p}</span>)}
            </div>
            <h3 class="post-title">{featured.title}</h3>
            <p>{featured.summary}</p>
            <div class="sh-feat-stats">
              {featured.outcomes.slice(0, 3).map((o) => (
                <div><b>{o.stat}</b><span>{o.label}</span></div>
              ))}
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Testimonials -->
  <Testimonials
    eyebrow={page.testimonialsHeading.eyebrow}
    title={page.testimonialsHeading.title}
    items={page.testimonials}
  />

  <!-- FAQ -->
  <Faq
    eyebrow={page.faqHeading.eyebrow}
    title={page.faqHeading.title}
    items={page.faqs.map((f) => ({ q: f.question, a: f.answer }))}
  />

  <ClosingCta
    title={page.closing.title}
    bordered={true}
    primary={page.closing.primary}
    secondary={page.closing.secondary}
  />
</Base>

<script>
  // Navigation is client-side, so this module is evaluated once for the whole
  // session. `astro:page-load` fires on the first load and after every swap,
  // which is what re-binds this to the incoming page's elements — without it
  // the controls are dead on every visit after the first. Every listener here
  // lands on a swapped element, so they are collected with the old page.
  document.addEventListener('astro:page-load', () => {
    // Revenue calculator — Shopify/CRO page only.
    const root = document.getElementById('cro-calc');
    if (root) {
      const ids = ['ci-vis', 'ci-aov', 'ci-cur', 'ci-tgt'] as const;
      const [vis, aov, cur, tgt] = ids.map((id) => document.getElementById(id) as HTMLInputElement | null);
      if (vis && aov && cur && tgt) {
        const set = (id: string, txt: string) => { const el = document.getElementById(id); if (el) el.textContent = txt; };
        const money = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
        // Expose progress as a custom property so CSS owns how the track looks
        // (the touch treatment on small screens restyles it entirely).
        const paint = (el: HTMLInputElement) => {
          const min = +el.min; const max = +el.max;
          el.style.setProperty('--fill', `${((+el.value - min) / (max - min)) * 100}%`);
        };
        const update = () => {
          const v = +vis.value, a = +aov.value, c = +cur.value, t = +tgt.value;
          const now = v * (c / 100) * a;
          const after = v * (t / 100) * a;
          const extraMo = after - now;
          const extraOrdersYr = v * ((t - c) / 100) * 12;
          set('cv-vis', v.toLocaleString('en-US'));
          set('cv-aov', '$' + a.toLocaleString('en-US'));
          set('cv-cur', c.toFixed(1) + '%');
          set('cv-tgt', t.toFixed(1) + '%');
          set('co-year', money(Math.max(extraMo * 12, 0)));
          const delta = (t - c).toFixed(1);
          set('co-sub', `from a ${t >= c ? '+' : ''}${delta} pt conversion change`);
          set('co-now', money(now) + '/mo');
          set('co-after', money(after) + '/mo');
          set('co-mo', (extraMo >= 0 ? '+' : '−') + money(Math.abs(extraMo)) + '/mo');
          set('co-orders', (extraOrdersYr >= 0 ? '+' : '−') + Math.round(Math.abs(extraOrdersYr)).toLocaleString('en-US'));
          [vis, aov, cur, tgt].forEach(paint);
        };
        [vis, aov, cur, tgt].forEach((el) => el.addEventListener('input', update));
        update();
      }
    }
  });
</script>
