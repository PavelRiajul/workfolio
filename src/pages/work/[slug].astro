---
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import { getProjects, getProject, getCaseStudy } from '../../lib/content';
import { caseStudySchema } from '../../lib/schema';
import type { Project } from '../../lib/types';

export async function getStaticPaths() {
  const projects = await getProjects();
  const studies = projects.filter((p) => p.hasCaseStudy);
  const full = (await Promise.all(studies.map((p) => getProject(p.slug)))).filter(
    Boolean
  ) as Project[];

  return full.map((project, i) => {
    const next = full[(i + 1) % full.length];
    return {
      params: { slug: project.slug },
      props: { project, nextName: next.title, nextSlug: next.slug },
    };
  });
}

interface Props { project: Project; nextName: string; nextSlug: string; }
const { project: p, nextName, nextSlug } = Astro.props;
const cs = await getCaseStudy();
const heroLabel = `${p.title} — hero mockup`;
const hasInsights = p.insights && p.insights.length > 0;
const hasMobile = p.mobileScreens && p.mobileScreens.length > 0;

const origin = (Astro.site ?? new URL(Astro.url.origin)).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---
<Base
  title={`${p.title} — Case Study`}
  description={p.summary}
  subpage={true}
  breadcrumbLeaf={p.title}
  schema={[caseStudySchema(p, origin, canonical)]}
>
  <article class="cs-article section section-flush-bottom">
    <a href="/#work" class="cs-back">← Back to work</a>

    <header class="stack-md" data-reveal>
      <div class="cs-pills">
        {p.pills.map((pill) => <span class="cs-pill">{pill}</span>)}
      </div>
      <h1 class="cs-title">{p.title} <span class="year">({p.year})</span></h1>
      <p class="cs-summary">{p.summary}</p>
    </header>

    <div class="cs-meta" data-reveal>
      {p.meta.map((m) => (
        <div><div class="lbl">{m.label}</div><div class="val">{m.value}</div></div>
      ))}
    </div>

    <div class="cs-hero" data-reveal><Placeholder label={heroLabel} image={p.image} src={`/work/${p.slug}.jpg`} alt={`${p.title} — ${p.type}`} /></div>
  </article>

  <section class="section section-flush-bottom">
    <div class="cs-split wrap" data-reveal>
      <div>
        <div class="eyebrow">{cs.challengeHeading.eyebrow}</div>
        <h2 class="cs-h2">{cs.challengeHeading.title.split('\n').map((l, i, a) => (<>{l}{i < a.length - 1 && <br />}</>))}</h2>
      </div>
      <div>{p.challenge.map((para) => <p class="cs-body">{para}</p>)}</div>
    </div>
  </section>

  <section class="section section-flush-bottom">
    <div class="cs-split wrap" data-reveal>
      <div>
        <div class="eyebrow">{cs.approachHeading.eyebrow}</div>
        <h2 class="cs-h2">{cs.approachHeading.title.split('\n').map((l, i, a) => (<>{l}{i < a.length - 1 && <br />}</>))}</h2>
      </div>
      <div>{p.approach.map((para) => <p class="cs-body">{para}</p>)}</div>
    </div>
  </section>

  {hasInsights && (
    <section class="section section-flush-bottom">
      <div class="wrap" data-reveal>
        <div class="eyebrow">{cs.insightsHeading.eyebrow}</div>
        <h2 class="cs-h2">{cs.insightsHeading.title}</h2>
        <div class="stack-lg">
          {p.insights.map((ins) => (
            <div class="cs-insight">
              <div>
                <div class="num">{ins.number} — PRINCIPLE</div>
                <h3>"{ins.finding}"</h3>
              </div>
              <div>
                <div class="how">How I applied it</div>
                <p>{ins.did}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section-flush-bottom">
    <div class="wrap" data-reveal>
      <div class="eyebrow">{cs.processHeading.eyebrow}</div>
      <h2 class="cs-h2">{cs.processHeading.title}</h2>
      <div class="cs-proc-grid">
        {p.processSteps.map((ph) => (
          <div class="cs-proc">
            <div class="frame"><Placeholder label={ph.label} /></div>
            <div class="pb">
              <div class="num">{ph.number}</div>
              <h3>{ph.title}</h3>
              <p>{ph.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-flush-bottom">
    <div class="wrap" data-reveal>
      <div class="eyebrow">{cs.screensHeading.eyebrow}</div>
      <h2 class="cs-h2">{cs.screensHeading.title}</h2>
      <div class="cs-screens">
        {p.screens.map((sc) => (
          <figure>
            <div class="frame"><Placeholder label={sc} /></div>
            <figcaption>{sc}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {hasMobile && (
    <section class="section section-flush-bottom">
      <div class="wrap" data-reveal>
        <div class="eyebrow">{cs.mobileHeading.eyebrow}</div>
        <h2 class="cs-h2">{cs.mobileHeading.title}</h2>
        <div class="cs-mobile">
          {p.mobileScreens.map((ms) => (
            <figure><div class="frame"><Placeholder label={ms} /></div></figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="cs-outcomes">
    <div class="section wrap">
      <div class="eyebrow">{cs.outcomesHeading.eyebrow}</div>
      <h2>{cs.outcomesHeading.title}</h2>
      <div class="cs-out-grid">
        {p.outcomes.map((o) => (
          <div><div class="stat">{o.stat}</div><div class="lbl">{o.label}</div></div>
        ))}
      </div>
      {p.outcomesNote && <p class="cs-out-note">{p.outcomesNote}</p>}
    </div>
  </section>

  <a class="next-link" href={`/work/${nextSlug}`}>
    <div class="section wrap">
      <div class="eyebrow">{cs.nextHeading.eyebrow}</div>
      <div class="next-row">
        <h2 class="next-name">{nextName}</h2>
        <span class="next-arrow">↗</span>
      </div>
    </div>
  </a>
</Base>
