---
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import PortableText from '../../components/PortableText.astro';
import Icon from '../../components/Icon.astro';
import Toc from '../../components/Toc.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import { getPosts, getBlogPage, getSite } from '../../lib/content';
import { articleSchema, faqSchema } from '../../lib/schema';
import { isPublished, relatedPosts, tableOfContents } from '../../lib/portable';
import { categoryLabel } from '../../lib/categories';
import { publicFileExists } from '../../lib/public-file';
import type { Post } from '../../lib/types';
import Headline from '../../components/Headline.astro';

// Only posts with a body get a page. An indexable URL carrying nothing but an
// excerpt is thin content — it competes with the pages that do rank and gives
// Google a reason to trust the domain less. Write the body, get the page.
export async function getStaticPaths() {
  const posts = await getPosts();
  const published = posts.filter(isPublished);

  return published.map((post) => {
    // "Read next" — the following post in publish order, wrapping around.
    const i = published.indexOf(post);
    const next = published[(i + 1) % published.length];
    return {
      params: { slug: post.slug },
      props: {
        post,
        next: next.slug === post.slug ? null : next,
        related: relatedPosts(post, posts),
        // Every other post in the same series, so a cluster reads as one body
        // of work instead of a set of pages that happen to share a tag.
        seriesPosts: post.series
          ? published.filter((p) => p.series === post.series && p.slug !== post.slug)
          : [],
      },
    };
  });
}

interface Props { post: Post; next: Post | null; related: Post[]; seriesPosts: Post[] }
const { post, next, related, seriesPosts } = Astro.props;
const [page, site] = await Promise.all([getBlogPage(), getSite()]);

const origin = (Astro.site ?? new URL(Astro.url.origin)).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogUrl = new URL(`/og/blog-${post.slug}.png`, Astro.site ?? Astro.url).href;
const toc = tableOfContents(post.body);

// Only show a cover when there is a real one. Body images already suppress
// themselves when the file is missing (Placeholder falls back, PortableText
// renders no figure) — the cover did not, so every post opened with a 540px
// hatched grey slab between the title and the first sentence. A placeholder is
// right where a caption is being wired up ahead of the photo; it is wrong as
// the first thing a reader meets on an article.
const coverSrc = `/blog/${post.slug}.jpg`;
const hasCover = Boolean(post.image?.asset?.url) || publicFileExists(coverSrc);
---
<Base
  title={post.seo?.title ?? `${post.title} — ${page.seo.title.split('—')[1]?.trim() ?? 'Blog'}`}
  description={post.seo?.description ?? post.excerpt}
  subpage={true}
  {/* The page node stays a WebPage; the BlogPosting is a separate node that
      references it via mainEntityOfPage. Two BlogPosting nodes would just be
      the same article claimed twice. */}
  pageType="WebPage"
  ogType="article"
  articleMeta={{
    publishedTime: post.publishedAt,
    modifiedTime: post.updatedAt ?? post.publishedAt,
    author: site.name,
    section: categoryLabel(post.category, post.categoryLabel),
  }}
  breadcrumbLeaf={post.title}
  schema={[articleSchema(post, origin, canonical, ogUrl), faqSchema(post.faqs ?? [])]}
>
  <article class="cs-article post-article section section-flush-bottom">
    <a href="/blog" class="cs-back">← Back to blog</a>

    {/* The header is centred and spans the full column; the two-column reading
        layout starts below it. Same arrangement as the reference design. */}
    <header class="post-head" data-reveal>
      <a class="pc-tag pc-tag-link" href={`/blog/category/${post.category}`}>{categoryLabel(post.category, post.categoryLabel)}</a>
      <h1 class="cs-title post-title">{post.title}</h1>
      <p class="cs-summary post-summary">{post.excerpt}</p>

      {/* One bordered strip carries author, date and read time, instead of the
          four separate lines they were scattered across. */}
      <div class="post-meta-bar">
        <div class="post-meta-who">
          <span class="post-avatar" aria-hidden="true">{site.name.slice(0, 1)}</span>
          <span class="post-meta-stack">
            <a class="post-meta-name" href="/about" rel="author">{site.name}</a>
            <span class="post-meta-sub">{site.role}</span>
          </span>
        </div>
        <div class="post-meta-when">
          <span><Icon name="fa-regular fa-clock" />{post.readTime}</span>
          <span class="post-sep" aria-hidden="true">·</span>
          <time datetime={post.publishedAt}>{post.date}</time>
          {post.updatedAt && post.updatedAt !== post.publishedAt && (
            <>
              <span class="post-sep" aria-hidden="true">·</span>
              <span class="post-updated">Updated <time datetime={post.updatedAt}>{post.updatedAt}</time></span>
            </>
          )}
        </div>
      </div>
    </header>

    {hasCover && (
      <div class="cs-hero" data-reveal>
        <Placeholder label={post.coverLabel} image={post.image} src={coverSrc} alt={post.title} />
      </div>
    )}

    <div class="post-layout">
      {/* Left rail. Sticky from 1024px up, where there is genuinely room for it
          — that width used to be empty space beside the text. Below it, the
          contents list falls back to the collapsed block above the article and
          the share card moves to the end. */}
      <aside class="post-rail">
        {toc.length > 0 && <Toc entries={toc} rail />}
        {/* One instance, moved by grid order rather than rendered twice and
            hidden. Wrapped rather than class-on-component, because a scoped
            rule in this page does not reach a child component's root element. */}
        <div class="post-share"><ShareLinks url={canonical} title={post.title} /></div>
      </aside>

      <div class="post-main">
        <div class="post-body" data-reveal>
          <PortableText blocks={post.body} />
        </div>

        {post.faqs && post.faqs.length > 0 && (
          <section class="post-faq" data-reveal>
            <h2 class="post-faq-title">Frequently asked questions</h2>
            {/* Rendered as visible HTML, not schema-only — Google stopped counting
                FAQ markup that has no on-page counterpart. <details> keeps the page
                short while leaving every answer in the DOM for a crawler. */}
            {post.faqs.map((f) => (
              <details class="post-faq-item">
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </section>
        )}

        <aside class="post-author" data-reveal>
      <div class="post-author-body">
        <p class="eyebrow">Written by</p>
        <h2 class="post-author-name">{site.name}</h2>
        <p>{site.seo.description}</p>
        {/* Credibility, not conversion. This used to repeat the closing card's
            "Get in touch" — two links to /start about 1,800px apart, the second
            one larger and the actual CTA. The author card's job is telling a
            reader who wrote this without making them leave the page. */}
        <div class="post-author-links">
          <a href="/about">More about me</a>
        </div>
      </div>
        </aside>
      </div>
    </div>

    {/* Related work spans the full width below the two-column area, as a 3-up
        grid — it is browsing, not reading, so it does not want the measure. */}
    {seriesPosts.length > 0 && (
      <aside class="post-related" data-reveal>
        <h2 class="eyebrow">Part of the {post.series} series</h2>
        <div class="post-related-grid">
          {seriesPosts.map((r) => (
            <a class="post-related-card" href={`/blog/${r.slug}`}>
              <span class="pc-tag">{categoryLabel(r.category, r.categoryLabel)}</span>
              <h3>{r.title}</h3>
              <p>{r.excerpt}</p>
            </a>
          ))}
        </div>
      </aside>
    )}

    {related.length > 0 && (
      <aside class="post-related" data-reveal>
        <h2 class="eyebrow">
          More in <a href={`/blog/category/${post.category}`}>{categoryLabel(post.category, post.categoryLabel)}</a>
        </h2>
        <div class="post-related-grid">
          {related.map((r) => (
            <a class="post-related-card" href={`/blog/${r.slug}`}>
              <span class="pc-tag">{categoryLabel(r.category, r.categoryLabel)}</span>
              <h3>{r.title}</h3>
              <p>{r.excerpt}</p>
            </a>
          ))}
        </div>
      </aside>
    )}

    {next && (
      <a class="cs-next" href={`/blog/${next.slug}`} data-reveal>
        <span class="eyebrow">Read next</span>
        <span class="cs-next-title">{next.title} <span aria-hidden="true">→</span></span>
      </a>
    )}
  </article>

  <section class="closing">
    <div class="closing-card">
      <h2><Headline text={page.closing.title} /></h2>
      <div class="closing-actions">
        <a href={page.closing.primary.href} class="btn btn-dark btn-cta">{page.closing.primary.label} <span>↗</span></a>
        <a href={page.closing.secondary.href} class="btn btn-light btn-cta">{page.closing.secondary.label}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Header ------------------------------------------------------------
     Centred and capped at the wide measure. The title used to run the full
     1180px container while the body sat in a 686px column beneath it, so the
     two halves of the page had different left edges. */
  .post-head {
    max-width: var(--prose-wide); margin: var(--space-md) auto 0;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: var(--space-sm);
  }
  .post-title { margin: 0; font-size: clamp(2rem, 1.3rem + 2.6vw, 3.25rem); line-height: 1.06; }
  .post-summary { margin: 0; max-width: 46rem; text-align: center; }

  .post-meta-bar {
    width: 100%; margin-top: var(--space-2xs);
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: var(--space-sm);
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .post-meta-who { display: flex; align-items: center; gap: var(--space-2xs); }
  /* Initial in a ring, until there is a real author photo to drop in. */
  .post-avatar {
    display: grid; place-items: center; width: 44px; height: 44px; flex: none;
    border-radius: 999px; border: 1px solid var(--line); background: var(--color-surface);
    font-family: var(--font-display); font-weight: 600; color: var(--color-ink);
  }
  .post-meta-stack { display: flex; flex-direction: column; line-height: 1.3; }
  .post-meta-name {
    font-family: var(--font-display); font-weight: 600; color: var(--color-ink);
    text-decoration: none;
  }
  .post-meta-name:hover { text-decoration: underline; text-underline-offset: 3px; }
  .post-meta-sub { font-size: .85rem; color: var(--color-grey-2); }
  .post-meta-when {
    display: flex; align-items: center; gap: var(--space-2xs); flex-wrap: wrap;
    font-size: .9rem; color: var(--color-grey-2);
  }
  .post-meta-when :global(svg) { width: 14px; height: 14px; fill: currentColor; margin-right: 5px; vertical-align: -2px; }
  .post-sep { color: var(--color-grey-3); }
  .post-updated { color: var(--color-grey-3); }
  .pc-tag-link { text-decoration: none; }
  .pc-tag-link:hover { border-color: rgba(10,10,10,.22); }

  /* ---- Two-column reading layout ----------------------------------------
     A left rail for navigation and sharing, and the article beside it. The
     rail occupies width that was previously empty: the prose column is capped
     for readability, so on a wide screen the alternative to a rail is dead
     space, not a wider line. */
  /* Single column below 1024px. The rail is `display: contents` so its two
     children become grid items in their own right and `order` can put the
     contents list above the article and the share row below it — one instance
     of each, rather than rendering the share block twice and hiding one. */
  .post-layout {
    display: grid; grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md); margin-top: var(--space-lg);
  }
  .post-rail { display: contents; }
  .post-rail :global(.toc) { order: 1; }
  .post-main { min-width: 0; order: 2; }
  .post-share { order: 3; margin-top: var(--space-lg); }

  @media (min-width: 1024px) {
    .post-layout {
      grid-template-columns: 250px minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: start;
    }
    /* Grid rather than flex, for one specific reason: a `minmax(0, 1fr)` grid
       track resolves to a definite height, so `height: 100%` inside the
       contents card works. As a flex column the card was stretched but its
       height stayed indefinite, percentages did not resolve, and the 1,296px
       list overflowed straight over the share row below it. */
    .post-rail {
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: var(--space-md);
      position: sticky; top: var(--space-lg);
      /* The rail never scrolls — the contents list does, inside its own card,
         so the share row stays reachable at the foot of it. */
      max-height: calc(100svh - var(--space-lg) - var(--space-md));
      min-height: 0;
    }
    /* DOM order (contents, then share) is what renders here — the `order`
       values above only matter in the single-column layout. */
    .post-rail :global(.toc) { min-height: 0; height: 100%; }
    .post-share { margin-top: 0; }
    /* Beside the rail, prose aligns to the left of the column rather than
       centring inside it. The main column is only ~130px wider than the
       measure, so centring put paragraphs 65px inside the left edge of the
       code blocks and tables — close enough to look like a mistake rather
       than a deliberate bleed. Shared left edge, wide blocks run right. */
    .post-main :global(.post-body) > :global(.pt-p),
    .post-main :global(.post-body) > :global(.pt-h2),
    .post-main :global(.post-body) > :global(.pt-h3),
    .post-main :global(.post-body) > :global(.pt-h4),
    .post-main :global(.post-body) > :global(.pt-list),
    .post-main :global(.post-body) > :global(.pt-quote) { margin-left: 0; margin-right: 0; }
    .post-main :global(.post-faq) { max-width: var(--prose); margin-left: 0; }
  }

  /* End-of-post author card. Search engines weigh who wrote a piece for
     anything advice-shaped, and a reader deciding whether to trust the post
     shouldn't have to leave it to find out. */
  /* End-of-article FAQ. Summaries clear the 44px touch target the rest of the
     site holds to. */
  .post-faq { margin-top: var(--space-2xl); max-width: 68ch; }
  .post-faq-title {
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.75rem);
    margin-bottom: var(--space-sm); color: var(--color-ink);
  }
  .post-faq-item { border-bottom: 1px solid var(--line); }
  .post-faq-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm);
    min-height: 44px; padding: var(--space-xs) 0; cursor: pointer;
    font-family: var(--font-display); font-weight: 600; color: var(--color-ink);
    list-style: none;
  }
  .post-faq-item summary::-webkit-details-marker { display: none; }
  .post-faq-item summary::after {
    content: '+'; flex: none; font-weight: 400; font-size: 1.25rem;
    color: var(--color-grey-2); transition: transform .22s cubic-bezier(.22,.61,.36,1);
  }
  .post-faq-item[open] summary::after { transform: rotate(45deg); }
  .post-faq-item p {
    margin: 0 0 var(--space-sm); color: var(--color-grey-1); line-height: 1.75;
  }

  .post-author {
    margin-top: var(--space-2xl); padding: var(--space-lg);
    border: 1px solid var(--line); border-radius: 18px; background: var(--color-surface);
  }
  .post-author-name {
    font-family: var(--font-display); font-size: 1.25rem; font-weight: 600;
    margin: var(--space-2xs) 0 var(--space-xs); color: var(--color-ink);
  }
  .post-author-body p:last-of-type { color: var(--color-grey-1); line-height: 1.7; max-width: 60ch; }
  .post-author-links { display: flex; flex-wrap: wrap; gap: var(--space-md); margin-top: var(--space-sm); }
  .post-author-links a {
    color: var(--color-blue); text-decoration: underline; text-underline-offset: 3px;
    font-size: .95rem; min-height: 44px; display: inline-flex; align-items: center;
  }

  .post-related { margin-top: var(--space-2xl); padding-top: var(--space-lg); border-top: 1px solid var(--line); }
  /* Two up on phones (the site-wide density rule), three from 900px — this is
     browsing rather than reading, so it takes the full width below the
     two-column area rather than the measure. */
  .post-related-grid {
    display: grid; gap: var(--space-sm); margin-top: var(--space-sm);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  /* auto-fit rather than a fixed 3, so a series with two posts fills the row
     instead of leaving a third of the width empty. */
  @media (min-width: 900px) {
    .post-related-grid { grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); }
  }
  .post-related-card {
    display: block; padding: var(--space-md); border: 1px solid var(--line);
    border-radius: 16px; text-decoration: none; color: inherit;
    transition: border-color .24s ease, transform .24s cubic-bezier(.22,.61,.36,1);
  }
  .post-related-card:hover { border-color: rgba(10,10,10,.22); transform: translateY(-2px); }
  .post-related-card h3 { font-family: var(--font-display); font-size: 1.02rem; font-weight: 600; margin: var(--space-2xs) 0; }
  .post-related-card p {
    color: var(--color-grey-2); font-size: .9rem; line-height: 1.6;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* Density over stacking, per the mobile rules — but two cards this text-heavy
     genuinely don't fit side by side on a phone. */
  @media (max-width: 640px) {
    .post-related-grid { grid-template-columns: 1fr; }
  }
</style>
