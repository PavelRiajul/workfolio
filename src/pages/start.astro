---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import { getStartPage } from '../lib/content';
import Headline from '../components/Headline.astro';

const page = await getStartPage();
const headlineLines = page.headlineLines;
// .hero-meta renders its own em-dash — don't double it up.
const heroEyebrow = page.eyebrow.replace(/^[—–-]\s*/, '');
---
<Base title={page.seo.title} description={page.seo.description} subpage={true} pageType="ContactPage">
  <!-- Hero — 3D stage: an incoming message, the slot it turns into, and
       the promise attached to both. -->
  <section class="hero hero-compact section-tight-bottom">
    <div class="hero-grid"></div>
    <div class="hero-inner shell" data-hero-intro>
      <div class="hero-meta" data-hero-item>
        <span>—</span>
        <span>{heroEyebrow}</span>
      </div>
      <h1 data-hero-item><Headline text={headlineLines} /></h1>
      <div class="hero-lower">
        <div class="hero-copy">
          <p class="hero-lede hero-lede-full" data-hero-item>{page.lede}</p>
          {page.ledeShort && <p class="hero-lede hero-lede-short" data-hero-item>{page.ledeShort}</p>}
        </div>
        <div class="hero-visual" data-hero-item aria-hidden="true">
          <div class="hv-stage" id="hv-stage">
            <div class="hv-card tk-msg"><div class="hv-inner">
              <div class="tk-msg-head"><span class="tk-av">JD</span><b>New message</b></div>
              <div class="tk-lines"><span></span><span class="w80"></span><span class="w50"></span></div>
              <div class="tk-chips"><span>MVP</span><span>3 weeks</span></div>
            </div></div>

            <div class="hv-card tk-slot"><div class="hv-inner">
              <div class="tk-slot-top">Thursday</div>
              <div class="tk-slot-time">9:30</div>
              <div class="tk-slot-meta">30 min · video call</div>
            </div></div>

            <div class="hv-card tk-reply"><div class="hv-inner">
              <Icon name="fa-solid fa-reply" />
              <span><b>&lt; 24h</b>reply, always</span>
            </div></div>

            <div class="hv-card tk-badge"><div class="hv-inner"><Icon name="fa-solid fa-paper-plane" /></div></div>
          </div>
        </div>
      </div>

      <div class="start-tabs" role="tablist" aria-label="Contact method">
        <button class="start-tab" data-tab="call" id="tab-call" role="tab" aria-selected="false" aria-controls="panel-call" tabindex="-1">{page.callTabLabel}</button>
        <button class="start-tab active" data-tab="form" id="tab-form" role="tab" aria-selected="true" aria-controls="panel-form" tabindex="0">{page.formTabLabel}</button>
      </div>
    </div>
  </section>

  <section class="start-wrap section section-flush-top">
    <!-- Book a call -->
    <div class="start-panel" data-panel="call" id="panel-call" role="tabpanel" aria-labelledby="tab-call" tabindex="0">
      <div class="call-card">
        <div class="call-grid">
          <div class="call-left">
            <h2>{page.call.title}</h2>
            <p>{page.call.body}</p>
            <div class="call-points">
              {page.call.points.map((pt) => (
                <div class="call-point"><span class="d"></span>{pt}</div>
              ))}
            </div>
          </div>
          <div class="call-right">
            {page.call.schedulerUrl ? (
              <div class="sched">
                <iframe
                  src={`${page.call.schedulerUrl}?hide_gdpr_banner=1&background_color=ffffff&text_color=0a0a0a&primary_color=2563eb`}
                  title={page.call.title}
                  loading="lazy"
                ></iframe>
                <a class="sched-link" href={page.call.schedulerUrl} target="_blank" rel="noopener">
                  {page.call.schedulerFallbackLabel}
                </a>
              </div>
            ) : (
              <Placeholder label={page.call.embedLabel} />
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Send a message -->
    <div class="start-panel active" data-panel="form" id="panel-form" role="tabpanel" aria-labelledby="tab-form" tabindex="0">
      <div class="form-card">
        <form id="contact-form">
          <div class="field-grid">
            <label class="flabel">
              <span class="lt">{page.form.nameLabel}</span>
              <input class="field" required type="text" placeholder={page.form.namePlaceholder} />
            </label>
            <label class="flabel">
              <span class="lt">{page.form.emailLabel}</span>
              <input class="field" required type="email" placeholder={page.form.emailPlaceholder} />
            </label>
          </div>

          <div class="stack-md">
            <span class="lt lt-block">{page.form.needsLabel}</span>
            <div class="check-list">
              {page.form.needs.map((n) => (
                <label class="check-lbl"><input type="checkbox" name="need" />{n}</label>
              ))}
            </div>
          </div>

          <div class="field-grid stack-md">
            <label class="flabel">
              <span class="lt">{page.form.budgetLabel} <span class="muted">(freelance)</span></span>
              <select class="field">
                <option value="" disabled selected>{page.form.budgetPlaceholder}</option>
                {page.form.budgets.map((b) => <option>{b}</option>)}
              </select>
            </label>
            <label class="flabel">
              <span class="lt">{page.form.timelineLabel}</span>
              <select class="field">
                <option value="" disabled selected>{page.form.timelinePlaceholder}</option>
                {page.form.timelines.map((t) => <option>{t}</option>)}
              </select>
            </label>
          </div>

          <label class="flabel stack-md">
            <span class="lt">{page.form.messageLabel}</span>
            <textarea class="field" rows="4" placeholder={page.form.messagePlaceholder}></textarea>
          </label>

          <div class="form-foot">
            <button type="submit" class="btn btn-dark btn-cta">{page.form.submitLabel} <span>↗</span></button>
            <span class="form-note">{page.form.note}</span>
          </div>
        </form>

        <div id="form-success" class="form-success" style="display:none;">
          <div class="tick">✓</div>
          <h2>{page.success.title}</h2>
          <p>{page.success.body}</p>
          <a href="/" class="btn btn-light stack-md">{page.success.backLabel}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Navigation is client-side, so this module is evaluated once for the whole
  // session. `astro:page-load` fires on the first load and after every swap,
  // which is what re-binds this to the incoming page's elements — without it
  // the controls are dead on every visit after the first. Every listener here
  // lands on a swapped element, so they are collected with the old page.
  document.addEventListener('astro:page-load', () => {
    // Contact tabs + form success — Start page only.
    const tabs = [...document.querySelectorAll<HTMLElement>('[role="tab"][data-tab]')];
    const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
    if (tabs.length) {
      // setFocus=true moves keyboard focus to the newly-selected tab (arrow nav);
      // false leaves focus alone (click / initial URL sync).
      const setTab = (name: string, setFocus = false) => {
        tabs.forEach((t) => {
          const on = t.dataset.tab === name;
          t.classList.toggle('active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1; // roving tabindex: one stop for the whole tablist
          if (on && setFocus) t.focus();
        });
        panels.forEach((p) => p.classList.toggle('active', p.dataset.panel === name));
        try {
          const u = new URL(location.href);
          u.searchParams.set('tab', name);
          history.replaceState(null, '', u);
        } catch { /* noop */ }
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => setTab(t.dataset.tab || 'form'));
        // Arrow keys move between tabs; Home/End jump to the ends (WAI-ARIA tabs).
        t.addEventListener('keydown', (e) => {
          const last = tabs.length - 1;
          let next = -1;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = i === last ? 0 : i + 1;
          else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = i === 0 ? last : i - 1;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = last;
          if (next < 0) return;
          e.preventDefault();
          setTab(tabs[next].dataset.tab || 'form', true);
        });
      });
      const initial = new URLSearchParams(location.search).get('tab');
      if (initial === 'call' || initial === 'form') setTab(initial);
    }
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const success = document.getElementById('form-success');
    if (form && success) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        form.style.display = 'none';
        success.style.display = 'block';
        try { window.scrollTo({ top: 0, behavior: 'smooth' }); } catch { window.scrollTo(0, 0); }
      });
    }
  });
</script>
