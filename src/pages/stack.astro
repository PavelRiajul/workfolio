---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { getStackPage } from '../lib/content';

const page = await getStackPage();
const heroLines = page.hero.headlineLines;
const templatesTitle = page.templatesHeading.title.split('\n');
const toolsTitle = page.toolsHeading.title.split('\n');
const everyTitle = page.everyBuildHeading.title.split('\n');
---
<Base title={page.seo.title} description={page.seo.description} subpage={true}>
  <!-- Hero — same 3D stage as the home hero, so initHeroTilt picks it up.
       The cards are decorative: a template, its database, and a deploy. -->
  <section class="hero">
    <div class="hero-grid"></div>
    <div class="hero-inner shell" data-hero-intro>
      <div class="hero-meta" data-hero-item>
        <span>—</span>
        <span>{page.hero.eyebrow}</span>
      </div>
      <h1 data-hero-item>
        {heroLines.map((l, i) => (<>{l}{i < heroLines.length - 1 && <br />}</>))}
        {page.hero.accentWord && <> <span class="accent">{page.hero.accentWord}</span></>}
      </h1>
      <div class="hero-lower">
        <div class="hero-copy">
          <p class="hero-lede hero-lede-full" data-hero-item>{page.hero.lede}</p>
          {page.hero.ledeShort && <p class="hero-lede hero-lede-short" data-hero-item>{page.hero.ledeShort}</p>}
          <div class="hero-actions" data-hero-item>
            <a href={page.hero.primaryCta.href} class="btn btn-dark">{page.hero.primaryCta.label} <span>↗</span></a>
            <a href={page.hero.secondaryCta.href} class="btn btn-light">{page.hero.secondaryCta.label}</a>
          </div>
          <div class="hero-stats" data-hero-item>
            {page.hero.stats.map((s) => (
              <div>
                <div class="num">{s.value}</div>
                <div class="lbl">{s.label}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="hero-visual" data-hero-item aria-hidden="true">
          <div class="hv-stage" id="hv-stage">
            <!-- the template -->
            <div class="hv-card st-layers"><div class="hv-inner">
              <div class="st-head"><Icon name="fa-solid fa-layer-group" /><span>Template 02</span></div>
              <div class="st-rows">
                <div class="st-row"><i class="fw"></i>Next.js<em>app</em></div>
                <div class="st-row"><i class="db"></i>Supabase<em>data</em></div>
                <div class="st-row"><i class="pay"></i>Stripe<em>billing</em></div>
                <div class="st-row"><i class="obs"></i>Sentry<em>errors</em></div>
              </div>
            </div></div>

            <!-- its database -->
            <div class="hv-card st-db"><div class="hv-inner">
              <div class="st-db-top"><span class="st-tbl">users</span><span class="st-rowcount">1,204</span></div>
              <div class="st-grid">
                <span></span><span class="w60"></span>
                <span></span><span class="w40"></span>
                <span></span><span class="w70"></span>
              </div>
            </div></div>

            <!-- shipped -->
            <div class="hv-card st-deploy"><div class="hv-inner">
              <div class="st-dep-head"><span class="st-dot"></span>Production</div>
              <div class="st-dep-main"><Icon name="fa-solid fa-circle-check" />Deployed</div>
              <div class="st-dep-meta"><span>main · 3f9c1a</span><b>14s</b></div>
            </div></div>

            <div class="hv-card st-badge"><div class="hv-inner"><Icon name="fa-solid fa-bolt" /></div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Build templates -->
  <section class="section section-bordered">
    <div class="wrap">
      <div class="eyebrow" data-reveal>{page.templatesHeading.eyebrow}</div>
      <h2 class="section-h2 measure-wide" data-reveal>
        {templatesTitle.map((l, i) => (<>{l}{i < templatesTitle.length - 1 && <br />}</>))}
      </h2>
      <p class="split-lede" data-reveal>{page.templatesHeading.lede}</p>

      <div class="tpl-grid">
        {page.templates.map((t) => (
          <article class={`tpl tone-${t.tone}`} data-reveal>
            <div class="tpl-top">
              <span class="tpl-num">{t.number}</span>
              <h3>{t.title}</h3>
            </div>
            <p class="tpl-lede">{t.tagline}</p>
            <div class="tpl-best"><span>Best for</span>{t.bestFor}</div>
            <ul class="tpl-stack">
              {t.stack.map((tool) => <li>{tool}</li>)}
              {t.stack.length > 5 && <li class="more">+{t.stack.length - 5}</li>}
            </ul>
            <p class="tpl-note">{t.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Toolbox -->
  <section class="section section-bordered">
    <div class="wrap">
      <div class="eyebrow" data-reveal>{page.toolsHeading.eyebrow}</div>
      <h2 class="section-h2 measure-wide" data-reveal>
        {toolsTitle.map((l, i) => (<>{l}{i < toolsTitle.length - 1 && <br />}</>))}
      </h2>
      <p class="split-lede" data-reveal>{page.toolsHeading.lede}</p>

      <div class="tool-grid">
        {page.toolGroups.map((g) => (
          <div class="tool-group" data-reveal>
            <h3>{g.title}</h3>
            <dl>
              {g.tools.map((t) => (
                <div class="tool-row">
                  <dt>{t.name}</dt>
                  <dd>{t.role}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- In every build (dark) -->
  <section class="section process">
    <div class="wrap">
      <div class="eyebrow" data-reveal>{page.everyBuildHeading.eyebrow}</div>
      <h2 class="section-h2" data-reveal>
        {everyTitle.map((l, i) => (<>{l}{i < everyTitle.length - 1 && <br />}</>))}
      </h2>
      <ul class="every-list" data-reveal>
        {page.everyBuild.map((item) => (
          <li><Icon name="fa-solid fa-check" />{item}</li>
        ))}
      </ul>
      <p class="every-note" data-reveal>{page.everyBuildNote}</p>
    </div>
  </section>

  <ClosingCta
    title={page.closing.title}
    bordered={true}
    primary={page.closing.primary}
    secondary={page.closing.secondary}
  />
</Base>
