---
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import WorkCard from '../components/WorkCard.astro';
import ClosingCta from '../components/ClosingCta.astro';
import ProjectModal from '../components/ProjectModal.astro';
import Mascot from '../components/Mascot.astro';
import ServiceStack from '../components/ServiceStack.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import { getSite, getHome, getProjects, getServices } from '../lib/content';

const site = await getSite();
const home = await getHome();
const projects = await getProjects();
const services = await getServices();
const bandTitle = home.aiBand.title.split('\n');
const processTitle = home.processHeading.title.split('\n');
---
<Base title={home.seo.title} description={home.seo.description} onHome={true} bodyClass="home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-grid"></div>
    <div class="hero-inner shell" data-hero-intro>
      <div class="hero-meta" data-hero-item>
        <span>—</span>
        <span>{home.badge}</span>
        <span class="chip-open"><span class="dot"></span>{home.availabilityChip}</span>
      </div>
      <h1 data-hero-item>
        {home.headlineLines.map((l, i) => (<>{l}{i < home.headlineLines.length - 1 && <br />}</>))}
        {home.accentWord && <> <span class="accent">{home.accentWord}</span></>}
      </h1>
      <div class="hero-lower">
        <div class="hero-copy">
          <p class="hero-lede hero-lede-full" data-hero-item>{home.lede}</p>
          {home.ledeShort && <p class="hero-lede hero-lede-short" data-hero-item>{home.ledeShort}</p>}
          <div class="hero-actions" data-hero-item>
            <a href={home.primaryCta.href} class="btn btn-dark">{home.primaryCta.label} <span>↗</span></a>
            <a href={home.secondaryCta.href} class="btn btn-light">{home.secondaryCta.label}</a>
          </div>
          <div class="hero-avail" data-hero-item>
            <span class="pulse"></span>{home.availabilityNote}
          </div>
          <div class="hero-building" data-hero-item>
            {home.buildingWithLabel} <span id="hero-rot" data-words={JSON.stringify(home.rotatingWords)}>{home.rotatingWords[0]}</span>
          </div>
          <div class="hero-stats" data-hero-item>
            {home.stats.map((s) => (
              <div>
                <div class="num" data-count={String(s.value)} data-suffix={s.suffix || ''}>0{s.suffix || ''}</div>
                <div class="lbl">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="hero-visual" data-hero-item aria-hidden="true">
          <div class="hv-stage" id="hv-stage">
            <div class="hv-card hv-code"><div class="hv-inner">
              <div class="hv-code-body mono">
                <div><span class="t-dim">›</span> <span class="t-key">build</span> the checkout</div>
                <div><span class="t-fn">✓</span> 14 files generated</div>
                <div><span class="t-fn">✓</span> tests passing</div>
                <div><span class="t-dim">›</span> reviewed by me</div>
              </div>
              <span class="hv-tag dark">AI-assisted</span>
            </div></div>
            <div class="hv-card hv-browser"><div class="hv-inner">
              <div class="hv-bar"><span></span><span></span><span></span><em>riajulislam.dev</em></div>
              <div class="hv-screen">
                <div class="hv-line w60"></div>
                <div class="hv-line w40"></div>
                <div class="hv-bars"><i style="height:40%"></i><i style="height:72%"></i><i style="height:54%"></i><i style="height:92%"></i><i style="height:66%"></i></div>
                <span class="hv-tag">Next.js</span>
              </div>
            </div></div>
            <div class="hv-card hv-phone"><div class="hv-inner">
              <div class="hv-notch"></div>
              <div class="hv-app">
                <div class="hv-line w50"></div>
                <div class="hv-row"></div>
                <div class="hv-row"></div>
                <div class="hv-cta"></div>
                <span class="hv-tag">React Native</span>
              </div>
            </div></div>
            <div class="hv-card hv-shop"><div class="hv-inner">
              <div class="hv-shop-head"><i class="fa-brands fa-shopify" aria-hidden="true"></i><span class="hv-shop-store"></span></div>
              <div class="hv-shop-img"></div>
              <div class="hv-shop-row"><span class="hv-shop-name"></span><span class="hv-shop-price">$48</span></div>
              <span class="hv-shop-btn">Add to cart</span>
            </div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Marquee items={site.techStack} cta={home.stackCta} />

  <!-- Proof of delivery — what I've built comes before what I sell -->
  <section id="work" class="section section-bordered">
    <div class="work-head" data-reveal>
      <div>
        <div class="eyebrow">{home.workHeading.eyebrow}</div>
        <h2>{home.workHeading.title}</h2>
      </div>
      <a href={home.workCta.href} class="btn btn-light btn-sm">{home.workCta.label}</a>
    </div>
    <div class="work-grid">
      {projects.map((p) => <WorkCard project={p} />)}
    </div>
    <p class="work-note" data-reveal>{home.workNote} <a href={home.workNoteLink.href}>{home.workNoteLink.label}</a></p>
  </section>

  <!-- What I do — the four offers -->
  <ServiceStack services={services} heading={home.servicesStackHeading} cta={home.servicesStackCta} />

  <!-- The AI-accelerated method (dark band) -->
  <section class="section section-bordered">
    <div class="wrap">
      <div class="croh croh-ai" data-reveal>
        <div class="croh-bg" aria-hidden="true"></div>
        <div class="croh-grid">
          <div class="croh-copy">
            <div class="eyebrow">{home.aiBand.eyebrow}</div>
            <h2 class="croh-h">
              {bandTitle.map((l, i) => (<>{l}{i < bandTitle.length - 1 && <br />}</>))}
              {home.aiBand.accentWord && <> <span class="accent">{home.aiBand.accentWord}</span></>}
            </h2>
            <p class="croh-p">{home.aiBand.body}</p>
            <a href={home.aiBand.link.href} class="croh-link">{home.aiBand.link.label} <span aria-hidden="true">→</span></a>
          </div>
          <div class="croh-stats" data-bars aria-hidden="true">
            {home.aiBand.stats.map((s) => (
              <div class="croh-stat">
                <div class="croh-num">
                  {s.prefix && <span class="pre">{s.prefix}</span>}
                  <span data-count={String(s.value)} data-suffix={s.suffix || ''}>{'0' + (s.suffix || '')}</span>
                </div>
                <div class="croh-bar"><i class="bargrow" style={`width:${s.barWidth || '100%'}`}></i></div>
                <div class="croh-lbl">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <p class="ai-caveat" data-reveal>{home.aiCaveat}</p>
    </div>
  </section>

  <!-- Proof: what clients say -->
  <Testimonials eyebrow={home.testimonialsHeading.eyebrow} title={home.testimonialsHeading.title} items={home.testimonials} />


  <!-- How we'll work together — a timeline, so it reads differently to the FAQ -->
  <section id="process" class="section process">
    <div class="wrap">
      <div data-reveal>
        <div class="eyebrow">{home.processHeading.eyebrow}</div>
        <h2 class="section-h2">{processTitle.map((l, i) => (<>{l}{i < processTitle.length - 1 && <br />}</>))}</h2>
        <p class="split-lede">{home.processHeading.lede}</p>
      </div>
      <div class="cyc cyc-blue" data-reveal>
        {home.process.map((s) => (
          <div class="cyc-step">
            <div class="cyc-node">{s.number}</div>
            <div class="cyc-body"><h3>{s.title}</h3><p>{s.body}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <Faq eyebrow={home.faqHeading.eyebrow} title={home.faqHeading.title} items={home.faqs.map((f) => ({ q: f.question, a: f.answer }))} />

  <ClosingCta title={home.closingTitle} />

  <ProjectModal projects={projects} />

  <Mascot />
</Base>
