---
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import WorkCard from '../components/WorkCard.astro';
import ClosingCta from '../components/ClosingCta.astro';
import ProjectModal from '../components/ProjectModal.astro';
import Mascot from '../components/Mascot.astro';
import ShopifyStack from '../components/ShopifyStack.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import { getSite, getHome, getProjects, getShopifyServices } from '../lib/content';

const site = await getSite();
const home = await getHome();
const projects = await getProjects();
const shopifyServices = await getShopifyServices();
---
<Base title={`${site.name} — ${site.role}`} description={home.lede} onHome={true} bodyClass="home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-grid"></div>
    <div class="hero-inner shell" data-hero-intro>
      <div class="hero-meta" data-hero-item>
        <span>—</span>
        <span>{home.badge}</span>
        <span class="chip-open"><span class="dot"></span>Available for projects</span>
      </div>
      <h1 data-hero-item>
        {home.headlineLines.map((l, i) => (<>{l}{i < home.headlineLines.length - 1 && <br />}</>))}
        {home.accentWord && <> <span class="accent">{home.accentWord}</span></>}
      </h1>
      <div class="hero-lower">
        <div class="hero-copy">
          <p class="hero-lede" data-hero-item>{home.lede}</p>
          <div class="hero-actions" data-hero-item>
            <a href="/start?tab=form" class="btn btn-dark">{home.primaryCta} <span>↗</span></a>
            <a href="/shopify" class="btn btn-light">{home.secondaryCta}</a>
          </div>
          <div class="hero-avail" data-hero-item>
            <span class="pulse"></span>{home.availabilityNote}
          </div>
          <div class="hero-building" data-hero-item>
            Currently building with <span id="hero-rot" data-words={JSON.stringify(home.rotatingWords)}>{home.rotatingWords[0]}</span>
          </div>
          <div class="hero-stats" data-hero-item>
            {home.stats.map((s) => (
              <div>
                <div class="num" data-count={String(s.value)} data-suffix={s.suffix || ''}>0{s.suffix || ''}</div>
                <div class="lbl">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="hero-visual" data-hero-item aria-hidden="true">
          <div class="hv-stage" id="hv-stage">
            <div class="hv-card hv-code"><div class="hv-inner">
              <div class="hv-code-body mono">
                <div><span class="t-key">const</span> <span class="t-fn">ship</span> = () <span class="t-key">=&gt;</span> {'{'}</div>
                <div>  <span class="t-fn">build</span>();</div>
                <div>  <span class="t-fn">deploy</span>();</div>
                <div>{'}'}</div>
              </div>
              <span class="hv-tag dark">TypeScript</span>
            </div></div>
            <div class="hv-card hv-browser"><div class="hv-inner">
              <div class="hv-bar"><span></span><span></span><span></span><em>riajulislam.dev</em></div>
              <div class="hv-screen">
                <div class="hv-line w60"></div>
                <div class="hv-line w40"></div>
                <div class="hv-bars"><i style="height:40%"></i><i style="height:72%"></i><i style="height:54%"></i><i style="height:92%"></i><i style="height:66%"></i></div>
                <span class="hv-tag">Next.js</span>
              </div>
            </div></div>
            <div class="hv-card hv-phone"><div class="hv-inner">
              <div class="hv-notch"></div>
              <div class="hv-app">
                <div class="hv-line w50"></div>
                <div class="hv-row"></div>
                <div class="hv-row"></div>
                <div class="hv-cta"></div>
                <span class="hv-tag">React Native</span>
              </div>
            </div></div>
            <div class="hv-card hv-shop"><div class="hv-inner">
              <div class="hv-shop-head"><i class="fa-brands fa-shopify" aria-hidden="true"></i><span class="hv-shop-store"></span></div>
              <div class="hv-shop-img"></div>
              <div class="hv-shop-row"><span class="hv-shop-name"></span><span class="hv-shop-price">$48</span></div>
              <span class="hv-shop-btn">Add to cart</span>
            </div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Marquee items={site.techStack} />

  <!-- What I do — Shopify (the offer) -->
  <ShopifyStack services={shopifyServices} />

  <!-- Shopify CRO highlight (teaser → /cro) -->
  <section class="section section-bordered">
    <div class="shell" style="padding:0;">
      <div class="croh" data-reveal>
        <div class="croh-bg" aria-hidden="true"></div>
        <div class="croh-grid">
          <div class="croh-copy">
            <div class="eyebrow">— Conversion-first</div>
            <h2 class="croh-h">Stores built to<br><span class="accent">convert</span>, not just look good.</h2>
            <p class="croh-p">CRO sits at the heart of every Shopify build I ship — audits, A/B tests and checkout tuning that grow revenue from the traffic you already have. Same visitors, more orders.</p>
            <a href="/cro" class="croh-link">Explore Shopify CRO <span aria-hidden="true">→</span></a>
          </div>
          <div class="croh-stats" data-bars aria-hidden="true">
            <div class="croh-stat">
              <div class="croh-num"><span class="pre">+</span><span data-count="62" data-suffix="%">0%</span></div>
              <div class="croh-bar"><i class="bargrow" style="width:84%"></i></div>
              <div class="croh-lbl">avg. conversion uplift</div>
            </div>
            <div class="croh-stat">
              <div class="croh-num"><span class="pre">−</span><span data-count="41" data-suffix="%">0%</span></div>
              <div class="croh-bar"><i class="bargrow" style="width:58%"></i></div>
              <div class="croh-lbl">cart abandonment</div>
            </div>
            <div class="croh-stat">
              <div class="croh-num"><span data-count="98" data-suffix="%">0%</span></div>
              <div class="croh-bar"><i class="bargrow" style="width:93%"></i></div>
              <div class="croh-lbl">A/B test confidence</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Proof: what clients say -->
  <Testimonials eyebrow="— What clients say" title="Don't take my word for it." items={home.testimonials} />

  <!-- Proof of delivery — Shopify first, generalist demoted to a link -->
  <section id="work" class="section section-bordered">
    <div class="work-head" data-reveal>
      <div>
        <div class="eyebrow">— Selected work</div>
        <h2>Proof it ships.</h2>
      </div>
      <a href="/work" class="btn btn-light btn-sm">All projects ↗</a>
    </div>
    <div class="work-grid" style="margin-top:40px;">
      {projects.map((p) => <WorkCard project={p} />)}
    </div>
    <p class="work-note" data-reveal>Mostly Shopify &amp; commerce lately — I also build Next.js web apps and React Native mobile apps. <a href="/work">See the full range →</a></p>
  </section>

  <!-- How we'll work together -->
  <section id="process" class="section process">
    <div class="split">
      <div data-reveal>
        <div class="eyebrow">— Process</div>
        <h2 class="section-h2">Built<br>for speed.</h2>
        <p class="split-lede">Six steps from first message to live store. No bloat, no ceremony — just momentum and clean commits.</p>
      </div>
      <div data-reveal>
        {home.process.map((s, i) => (
          <details class="acc" open={i === 0}>
            <summary><span class="acc-label"><span class="acc-num">{s.number}</span><span class="acc-title sm">{s.title}</span></span><span class="acc-ic">+</span></summary>
            <p>{s.body}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <Faq eyebrow="— FAQ" title={"Questions,\nanswered."} items={home.faqs.map((f) => ({ q: f.question, a: f.answer }))} />

  <ClosingCta title={home.closingTitle} />

  <ProjectModal projects={projects} />

  <Mascot />
</Base>
