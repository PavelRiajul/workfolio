---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import { getPosts, getBlogPage } from '../lib/content';

const posts = await getPosts();
const page = await getBlogPage();
const heroLines = page.hero.headlineLines;
// .hero-meta renders its own em-dash — don't double it up.
const heroEyebrow = page.hero.eyebrow.replace(/^[—–-]\s*/, '');
const closingLines = page.closing.title.split('\n');
const featured = posts.find((p) => p.featured);
const rest = posts.filter((p) => !p.featured);

---
<Base title={page.seo.title} description={page.seo.description} subpage={true}>
  <!-- Hero — 3D stage: a post being written, one already out, and its tags. -->
  <section class="hero hero-compact">
    <div class="hero-grid"></div>
    <div class="hero-inner shell" data-hero-intro>
      <div class="hero-meta" data-hero-item>
        <span>—</span>
        <span>{heroEyebrow}</span>
      </div>
      <h1 data-hero-item>{heroLines.map((l, i) => (<>{l}{i < heroLines.length - 1 && <br />}</>))}</h1>
      <div class="hero-lower">
        <div class="hero-copy">
          <p class="hero-lede" data-hero-item>{page.hero.lede}</p>
        </div>
        <div class="hero-visual" data-hero-item aria-hidden="true">
          <div class="hv-stage" id="hv-stage">
            <div class="hv-card bl-post"><div class="hv-inner">
              <div class="bl-kicker">AI · 8 min read</div>
              <div class="bl-title"><span></span><span class="w70"></span></div>
              <div class="bl-body"><span></span><span></span><span class="w60"></span></div>
            </div></div>

            <div class="hv-card bl-editor"><div class="hv-inner">
              <div class="bl-ed-bar"><em>draft.md</em></div>
              <div class="bl-ed-body">
                <div><span class="h">##</span> Where the weeks go</div>
                <div><span class="d">Most bad answers are</span></div>
                <div><span class="d">bad retrieval, not</span><span class="caret"></span></div>
              </div>
            </div></div>

            <div class="hv-card bl-tags"><div class="hv-inner">
              <span>AI</span><span>Shopify</span><span>Next.js</span><span>Career</span>
            </div></div>

            <div class="hv-card bl-badge"><div class="hv-inner"><i class="fa-solid fa-feather" aria-hidden="true"></i></div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="filters">
        {page.categories.map((c, i) => (
          <button class={`chip ${i === 0 ? 'active' : ''}`} data-blog-filter={c.href} aria-pressed={i === 0 ? 'true' : 'false'}>{c.label}</button>
        ))}
      </div>

      {featured && (
        <a class="post-card post-feature stack-lg" data-category={featured.category} href="#">
          <div class="cover"><div class="post-img-zoom"><Placeholder label={featured.coverLabel} image={featured.image} /></div></div>
          <div class="pf-body">
            <div class="pf-meta">
              <span class="pf-badge">{page.featuredBadge}</span>
              <span class="pf-sub">{featured.categoryLabel} · {featured.readTime}</span>
            </div>
            <h2 class="post-title">{featured.title}</h2>
            <p>{featured.excerpt}</p>
            <div class="post-date">{featured.date}</div>
          </div>
        </a>
      )}

      <div class="post-grid stack-lg">
        {rest.map((p) => (
          <a class="post-card" data-category={p.category} href="#">
            <div class="cover"><div class="post-img-zoom"><Placeholder label={p.coverLabel} image={p.image} /></div></div>
            <div class="pc-meta"><span class="pc-tag">{p.categoryLabel}</span>{p.readTime}</div>
            <h3 class="post-title">{p.title}</h3>
            <p>{p.excerpt}</p>
            <div class="post-date">{p.date}</div>
          </a>
        ))}
      </div>
      <div id="blog-empty" class="blog-empty">{page.emptyMessage}</div>
    </div>
  </section>

  <section class="closing">
    <div class="closing-card">
      <h2>{closingLines.map((l, i) => (<>{l}{i < closingLines.length - 1 && <br />}</>))}</h2>
      <div class="closing-actions">
        <a href={page.closing.primary.href} class="btn btn-dark btn-cta">{page.closing.primary.label} <span>↗</span></a>
        <a href={page.closing.secondary.href} class="btn btn-light btn-cta">{page.closing.secondary.label}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Blog category filter — Blog page only.
  const chips = document.querySelectorAll<HTMLElement>('[data-blog-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  const empty = document.getElementById('blog-empty');
  if (chips.length) {
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const f = chip.dataset.blogFilter;
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle('active', on);
          c.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        let shown = 0;
        cards.forEach((card) => {
          const show = f === 'all' || card.dataset.category === f;
          card.style.display = show ? '' : 'none';
          if (show) shown++;
        });
        if (empty) empty.style.display = shown === 0 ? 'block' : 'none';
      });
    });
  }
</script>
