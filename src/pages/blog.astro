---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import { getPosts, getBlogPage } from '../lib/content';
import { categoryLabel } from '../lib/categories';
import { publicFileExists } from '../lib/public-file';
import Headline from '../components/Headline.astro';

const posts = await getPosts();
const page = await getBlogPage();
const heroLines = page.hero.headlineLines;
// .hero-meta renders its own em-dash — don't double it up.
const heroEyebrow = page.hero.eyebrow.replace(/^[—–-]\s*/, '');
const closingLines = page.closing.title.split('\n');
const featured = posts.find((p) => p.featured);
const rest = posts.filter((p) => !p.featured);

// A card links to its post only once that post has a body — those are the only
// slugs [slug].astro generates a page for, so linking earlier would 404.
const hrefFor = (p: (typeof posts)[number]) => (p.body?.length ? `/blog/${p.slug}` : undefined);

// Categories that actually have a hub page — mirrors the getStaticPaths rule in
// blog/category/[category].astro, so a chip never links to a route that
// wasn't generated.
const hubHrefs = new Set(posts.filter((p) => p.body?.length).map((p) => p.category));

// Same rule as the post page: a card shows a cover only when there is a real
// one. With no artwork on the site yet this page rendered 47 identical hatched
// rectangles, the featured one 1134x709 — a full screen of nothing above the
// first headline, and the dominant visual element of the page. A placeholder
// earns its place where one photo is pending among many; it does not where
// every single image is missing. Drop a file into /public/blog and the cover
// comes back with no code change.
const coverFor = (p: (typeof posts)[number]) => `/blog/${p.slug}.jpg`;
const hasCover = (p: (typeof posts)[number]) =>
  Boolean(p.image?.asset?.url) || publicFileExists(coverFor(p));

---
<Base title={page.seo.title} description={page.seo.description} subpage={true} pageType="Blog">
  <!-- Hero — 3D stage: a post being written, one already out, and its tags. -->
  <section class="hero hero-compact">
    <div class="hero-grid"></div>
    <div class="hero-inner shell" data-hero-intro>
      <div class="hero-meta" data-hero-item>
        <span>—</span>
        <span>{heroEyebrow}</span>
      </div>
      <h1 data-hero-item><Headline text={heroLines} /></h1>
      <div class="hero-lower">
        <div class="hero-copy">
          <p class="hero-lede hero-lede-full" data-hero-item>{page.hero.lede}</p>
          {page.hero.ledeShort && <p class="hero-lede hero-lede-short" data-hero-item>{page.hero.ledeShort}</p>}
        </div>
        <div class="hero-visual" data-hero-item aria-hidden="true">
          <div class="hv-stage" id="hv-stage">
            <div class="hv-card bl-post"><div class="hv-inner">
              <div class="bl-kicker">AI · 8 min read</div>
              <div class="bl-title"><span></span><span class="w70"></span></div>
              <div class="bl-body"><span></span><span></span><span class="w60"></span></div>
            </div></div>

            <div class="hv-card bl-editor"><div class="hv-inner">
              <div class="bl-ed-bar"><em>draft.md</em></div>
              <div class="bl-ed-body">
                <div><span class="h">##</span> Where the weeks go</div>
                <div><span class="d">Most bad answers are</span></div>
                <div><span class="d">bad retrieval, not</span><span class="caret"></span></div>
              </div>
            </div></div>

            <div class="hv-card bl-tags"><div class="hv-inner">
              <span>AI</span><span>Shopify</span><span>Next.js</span><span>Career</span>
            </div></div>

            <div class="hv-card bl-badge"><div class="hv-inner"><Icon name="fa-solid fa-feather" /></div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {/* Real links, not buttons: a crawler follows them to the topic hubs and
          they work with JS off. The script below intercepts the click and
          filters in place, so the fast interaction is unchanged. Categories
          with no published post have no hub, so those stay filter-only. */}
      <div class="filters">
        {page.categories.map((c, i) => (
          <a
            class={`chip ${i === 0 ? 'active' : ''}`}
            href={c.href === 'all' ? '/blog' : hubHrefs.has(c.href) ? `/blog/category/${c.href}` : undefined}
            data-blog-filter={c.href}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >{c.label}</a>
        ))}
      </div>

      {featured && (
        <a
          class={`post-card post-feature stack-lg ${hrefFor(featured) ? '' : 'post-unwritten'} ${hasCover(featured) ? '' : 'no-cover'}`}
          data-category={featured.category}
          href={hrefFor(featured)}
        >
          {hasCover(featured) && (
            <div class="cover"><div class="post-img-zoom"><Placeholder label={featured.coverLabel} image={featured.image} src={coverFor(featured)} /></div></div>
          )}
          <div class="pf-body">
            <div class="pf-meta">
              <span class="pf-badge">{page.featuredBadge}</span>
              <span class="pf-sub">{categoryLabel(featured.category, featured.categoryLabel)} · {featured.readTime}</span>
            </div>
            <h2 class="post-title">{featured.title}</h2>
            <p>{featured.excerpt}</p>
            <div class="post-date">{featured.date}</div>
          </div>
        </a>
      )}

      <div class="post-grid stack-lg">
        {rest.map((p) => (
          <a
            class={`post-card ${hrefFor(p) ? '' : 'post-unwritten'} ${hasCover(p) ? '' : 'no-cover'}`}
            data-category={p.category}
            href={hrefFor(p)}
          >
            {hasCover(p) && (
              <div class="cover"><div class="post-img-zoom"><Placeholder label={p.coverLabel} image={p.image} src={coverFor(p)} /></div></div>
            )}
            <div class="pc-meta"><span class="pc-tag">{categoryLabel(p.category, p.categoryLabel)}</span>{p.readTime}</div>
            <h3 class="post-title">{p.title}</h3>
            <p>{p.excerpt}</p>
            <div class="post-date">{p.date}</div>
          </a>
        ))}
      </div>
      <div id="blog-empty" class="blog-empty">{page.emptyMessage}</div>
    </div>
  </section>

  <section class="closing">
    <div class="closing-card">
      <h2><Headline text={closingLines} /></h2>
      <div class="closing-actions">
        <a href={page.closing.primary.href} class="btn btn-dark btn-cta">{page.closing.primary.label} <span>↗</span></a>
        <a href={page.closing.secondary.href} class="btn btn-light btn-cta">{page.closing.secondary.label}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* A card whose post isn't written yet: same card, no hover affordance and no
     pointer, because there's nothing to click through to. */
  .post-unwritten { cursor: default; }
</style>

<script>
  // Navigation is client-side, so this module is evaluated once for the whole
  // session. `astro:page-load` fires on the first load and after every swap,
  // which is what re-binds these to the incoming page's elements — without it
  // the controls are dead on every visit after the first. Listeners land on
  // swapped elements, so they are collected with them and need no teardown.
  document.addEventListener('astro:page-load', () => {
    // Blog category filter — Blog page only.
    const chips = document.querySelectorAll<HTMLElement>('[data-blog-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-category]');
    const empty = document.getElementById('blog-empty');
    if (chips.length) {
      chips.forEach((chip) => {
        chip.addEventListener('click', (ev) => {
          // The chips are real links to the topic hubs so crawlers can follow
          // them and the page works without JS. With JS we filter in place
          // instead — but let modified clicks (new tab, etc.) behave normally.
          const e = ev as MouseEvent;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
          e.preventDefault();
          const f = chip.dataset.blogFilter;
          chips.forEach((c) => {
            const on = c === chip;
            c.classList.toggle('active', on);
            c.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
          let shown = 0;
          cards.forEach((card) => {
            const show = f === 'all' || card.dataset.category === f;
            card.style.display = show ? '' : 'none';
            if (show) shown++;
          });
          if (empty) empty.style.display = shown === 0 ? 'block' : 'none';
        });
      });
    }
  });
</script>
