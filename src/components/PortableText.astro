---
// Minimal Portable Text renderer — the handful of block types a technical
// article actually uses. Deliberately not a dependency: the whole surface is
// paragraphs, headings, lists, quotes, images, code and four inline marks, and
// a library would cost more than it saves here.
//
// Consecutive list items are coalesced into one <ul>/<ol>. That's the part
// hand-rolled renderers usually get wrong — Portable Text stores every bullet
// as its own sibling block, so rendering naively yields one list per item.
import { Code } from 'astro:components';
import { publicFileExists } from '../lib/public-file';
import type { PortableBlock } from '../lib/types';
import { headings } from '../lib/portable';
import Span from './PortableSpan.astro';

interface Props { blocks?: PortableBlock[] }
const { blocks = [] } = Astro.props;

// Heading ids come from the shared helper so they match the TOC exactly,
// including the suffix it adds when two headings share a title. Consumed in
// document order as the headings render.
const headingIds = headings(blocks).map((h) => h.id);
let headingCursor = 0;

type Group =
  | { kind: 'block'; block: PortableBlock }
  | { kind: 'list'; ordered: boolean; items: PortableBlock[] };

const groups: Group[] = [];
for (const b of blocks) {
  if (b.listItem) {
    const ordered = b.listItem === 'number';
    const last = groups[groups.length - 1];
    if (last && last.kind === 'list' && last.ordered === ordered) last.items.push(b);
    else groups.push({ kind: 'list', ordered, items: [b] });
  } else {
    groups.push({ kind: 'block', block: b });
  }
}

/** A block the editor left blank — renders as nothing, not an empty <p>. */
const isEmpty = (b: PortableBlock) => !b.children?.some((s) => s.text.trim());

/** Sanity upload wins; otherwise a file in /public, checked at build time so a
 *  path typo shows up as a missing figure rather than a broken image icon. */
function imageSrc(b: PortableBlock): string | undefined {
  if (b.asset?.url) return b.asset.url;
  if (b.src) return publicFileExists(b.src) ? b.src : undefined;
  return undefined;
}

// Shiki needs a language it knows; unlabelled blocks render as plain text.
const KNOWN = new Set([
  'astro', 'bash', 'css', 'diff', 'go', 'graphql', 'html', 'ini', 'java', 'js',
  'javascript', 'json', 'jsonc', 'jsx', 'liquid', 'md', 'markdown', 'php',
  'python', 'rust', 'scss', 'sh', 'shell', 'sql', 'svelte', 'toml', 'ts',
  'tsx', 'typescript', 'vue', 'xml', 'yaml', 'yml',
]);
const langOf = (b: PortableBlock) => {
  const l = (b.language || '').toLowerCase().trim();
  return KNOWN.has(l) ? l : 'plaintext';
};
---

{
  groups.map((g) => {
    if (g.kind === 'list') {
      return g.ordered ? (
        <ol class="pt-list">
          {g.items.map((b) => (
            <li>{b.children?.map((s) => <Span span={s} defs={b.markDefs} />)}</li>
          ))}
        </ol>
      ) : (
        <ul class="pt-list">
          {g.items.map((b) => (
            <li>{b.children?.map((s) => <Span span={s} defs={b.markDefs} />)}</li>
          ))}
        </ul>
      );
    }

    const b = g.block;

    if (b._type === 'image') {
      const src = imageSrc(b);
      if (!src) return null;
      return (
        <figure class={`pt-figure${b.wide ? ' pt-figure-wide' : ''}`}>
          <img src={src} alt={b.alt ?? ''} loading="lazy" decoding="async" />
          {b.caption && <figcaption>{b.caption}</figcaption>}
        </figure>
      );
    }

    if (b._type === 'code') {
      return b.code ? (
        <div class="pt-code">
          <Code code={b.code} lang={langOf(b) as any} theme="github-light" />
        </div>
      ) : null;
    }

    if (isEmpty(b)) return null;

    const kids = b.children?.map((s) => <Span span={s} defs={b.markDefs} />);

    // Headings get a stable id so the TOC and any shared link can target them.
    if (b.style === 'h2' || b.style === 'h3') {
      const id = headingIds[headingCursor++];
      const Tag = b.style;
      return (
        <Tag id={id} class={`pt-${b.style} pt-anchored`}>
          {kids}
          <a class="pt-anchor" href={`#${id}`} aria-label="Link to this section">#</a>
        </Tag>
      );
    }
    if (b.style === 'h4') return <h4 class="pt-h4">{kids}</h4>;
    if (b.style === 'blockquote') return <blockquote class="pt-quote">{kids}</blockquote>;
    return <p class="pt-p">{kids}</p>;
  })
}

<style is:global>
  /* Article body. Measure is capped for readability; type inherits the site's
     existing scale rather than introducing a second one. */
  .post-body { max-width: 68ch; }
  .post-body .pt-p { margin-bottom: var(--space-md); color: var(--color-grey-1); line-height: 1.75; }
  .post-body .pt-h2 {
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.75rem);
    margin-top: var(--space-xl); margin-bottom: var(--space-sm); color: var(--color-ink);
  }
  .post-body .pt-h3 {
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.015em;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.3rem);
    margin-top: var(--space-lg); margin-bottom: var(--space-2xs); color: var(--color-ink);
  }
  .post-body .pt-h4 {
    font-family: var(--font-display); font-weight: 600; font-size: 1rem;
    margin-top: var(--space-md); margin-bottom: var(--space-2xs); color: var(--color-ink);
  }
  .post-body .pt-list { margin: 0 0 var(--space-md); padding-left: 1.35em; color: var(--color-grey-1); }
  .post-body .pt-list li { margin-bottom: var(--space-2xs); line-height: 1.7; }
  .post-body .pt-quote {
    margin: var(--space-lg) 0; padding-left: var(--space-md);
    border-left: 3px solid var(--color-blue);
    font-size: 1.05em; color: var(--color-ink);
  }
  .post-body a { color: var(--color-blue); text-decoration: underline; text-underline-offset: 3px; }

  /* Heading anchors — hidden until the heading is hovered or the link is
     focused, so they never clutter the reading view but stay keyboard-usable. */
  .post-body .pt-anchored { position: relative; scroll-margin-top: 90px; }
  .post-body .pt-anchor {
    margin-left: .4em; color: var(--color-grey-3); text-decoration: none;
    opacity: 0; transition: opacity .18s ease; font-weight: 400;
  }
  .post-body .pt-anchored:hover .pt-anchor,
  .post-body .pt-anchor:focus-visible { opacity: 1; }

  /* Figures. `wide` breaks out past the 68ch measure for diagrams. */
  .post-body .pt-figure { margin: var(--space-lg) 0; }
  .post-body .pt-figure img {
    display: block; width: 100%; height: auto;
    border: 1px solid var(--line); border-radius: 14px; background: var(--color-surface);
  }
  .post-body .pt-figure figcaption {
    margin-top: var(--space-2xs); font-size: .85rem; color: var(--color-grey-2); line-height: 1.5;
  }
  @media (min-width: 900px) {
    .post-body .pt-figure-wide { width: min(112%, calc(100vw - 2 * var(--gutter))); }
  }

  /* Shiki emits its own <pre class="astro-code">; this is the frame around it. */
  .post-body .pt-code { margin: 0 0 var(--space-md); }
  .post-body .pt-code pre {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--line); border-radius: 12px;
    overflow-x: auto; font-size: .85em; line-height: 1.65;
  }
  .post-body .pt-code code { font-family: var(--font-mono); }
  /* Inline code — not the highlighted blocks. */
  .post-body :not(.pt-code) > p > code,
  .post-body .pt-list code,
  .post-body .pt-quote code {
    font-family: var(--font-mono); font-size: 0.88em;
    background: var(--color-surface); border: 1px solid var(--line);
    padding: 0.1em 0.35em; border-radius: 5px;
  }
</style>
