---
// Contents list for a post. Ids come from lib/portable so they always match
// the ids PortableText stamps on the headings.
//
// Sticky beside the article on wide screens, a collapsed <details> on
// narrower ones — a phone shouldn't spend half a screen on navigation before
// the first paragraph.
import type { TocEntry } from '../lib/portable';

interface Props { entries: TocEntry[]; label?: string; rail?: boolean }
const { entries, label = 'On this page', rail = false } = Astro.props;

// Nest each h3 under the h2 above it. Flat, a post with 11 sections and 15
// sub-sections is 26 rows — taller than the rail, so it scrolled internally
// and showed five of the eleven sections with no visible scrollbar to say so.
// Grouped, every top-level section is on screen at once and the sub-sections
// for the one being read open beneath it.
const groups: { entry: TocEntry; children: TocEntry[] }[] = [];
for (const e of entries) {
  if (e.level === 2 || groups.length === 0) groups.push({ entry: e, children: [] });
  else groups[groups.length - 1].children.push(e);
}
---
{entries.length > 0 && (
  <nav class={`toc ${rail ? 'toc-rail' : ''}`} aria-label={label}>
    <details class="toc-shell" open>
      <summary><span>{label}</span><span class="toc-caret" aria-hidden="true">+</span></summary>
      <ol>
        {groups.map((g) => (
          <li class="toc-group">
            <a href={`#${g.entry.id}`}>{g.entry.text}</a>
            {g.children.length > 0 && (
              <ol class="toc-children">
                {g.children.map((c) => (
                  <li class="toc-sub"><a href={`#${c.id}`}>{c.text}</a></li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}

<style>
  /* Same measure as `.post-body`. The contents list is text, and text that
     indexes a 68ch column should not itself run to 1060px — the mismatch left
     a wide dead margin down the right of the card and two different left-to-
     right rhythms stacked on top of each other. */
  .toc { margin: 0 auto var(--space-lg); max-width: var(--prose); }
  .toc-shell {
    border: 1px solid var(--line); border-radius: 14px;
    padding: var(--space-sm) var(--space-md); background: var(--color-surface);
  }
  summary {
    display: flex; align-items: center; justify-content: space-between;
    cursor: pointer; list-style: none; min-height: 44px;
    font-family: var(--font-display); font-size: .8rem; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase; color: var(--color-grey-2);
  }
  summary::-webkit-details-marker { display: none; }
  .toc-caret { font-size: 1.1rem; color: var(--color-grey-3); transition: transform .2s ease; }
  details[open] .toc-caret { transform: rotate(45deg); }

  ol { list-style: none; margin: var(--space-2xs) 0 0; padding: 0; counter-reset: toc; }
  /* Only top-level entries are numbered. Incrementing on sub-entries too would
     make the h2 numbers skip (1, then 6) and read as broken. */
  .toc-group { counter-increment: toc; }

  /* Sub-sections belong to the section being read. Collapsed otherwise, so all
     eleven top-level sections fit on screen instead of five. Nothing is lost —
     the headings are in the article, and the parent link still reaches them. */
  .toc-children { margin: 0; padding: 0; display: none; }
  .toc-group.is-open > .toc-children,
  .toc-group:focus-within > .toc-children { display: block; }
  /* Posts run to 14+ H2s and 15+ H3s, so the list is long by design. Keeping
     rows tight is what stops it occupying most of a screen before the first
     paragraph. Touch targets stay at 44px on coarse pointers below. */
  li a {
    display: block; padding: 3px 0; font-size: .92rem; line-height: 1.45;
    color: var(--color-grey-1); text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  li a:hover { color: var(--color-ink); }
  li a::before { content: counter(toc) '. '; color: var(--color-grey-3); }
  .toc-sub { padding-left: var(--space-sm); }
  .toc-sub a { font-size: .87rem; color: var(--color-grey-2); }
  .toc-sub a::before { content: '— '; }

  /* The section being read. Marked with a rule down the left edge rather than
     a background, so it reads at a glance without turning the list into a
     block of colour — and the ink weight change carries it for anyone who
     cannot separate the blue from the grey. */
  li a.is-current {
    color: var(--color-ink); font-weight: 600;
    box-shadow: inset 2px 0 0 var(--color-blue);
    padding-left: var(--space-2xs);
  }
  li a.is-current::before { color: var(--color-blue); }
  @media (prefers-reduced-motion: no-preference) {
    li a { transition: color .18s ease; }
  }

  /* Anything without a precise pointer keeps the site-wide 44px minimum. */
  @media (pointer: coarse) {
    li a { padding: 10px 0; min-height: 44px; }
  }

  /* Rail variant. Posts run to 26 entries, which is taller than a viewport, so
     the *list* scrolls inside the card rather than the card being clipped by
     the rail. Scrolling the rail instead put everything below the contents —
     the share buttons — out of reach, and cut the last entry mid-word with no
     indication there was more. The heading stays put so the scroll has an
     anchor. */
  /* The card itself is the scroll container, with the heading pinned inside it.
     Two things had to be ruled out first: `max-height: 100%` on the shell does
     not resolve against an auto-height flex parent, and making <details> a
     flex container does not make its content a flex item — Chrome lays the
     content out in its own box, so the list kept its full 1,296px height and
     spilled over the share row beneath. Giving the shell `overflow-y: auto`
     works because flex has already resolved a real height for it. */
  .toc-rail { max-width: none; margin: 0; min-height: 0; }
  .toc-rail .toc-shell {
    height: 100%; overflow-y: auto; overscroll-behavior: contain;
    padding-top: 0;
  }
  .toc-rail summary {
    position: sticky; top: 0; z-index: 1;
    background: var(--color-surface);
    padding-top: var(--space-sm);
    border-bottom: 1px solid var(--line-soft);
  }
  .toc-rail ol { margin-top: var(--space-xs); }

  @media (prefers-reduced-motion: reduce) {
    .toc-caret { transition: none; }
  }
</style>
