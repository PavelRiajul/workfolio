---
import Icon from './Icon.astro';
// The CRO "dashboard" visual: a conversion-uplift card, a live A/B test with
// a winner, and a checkout funnel. Every number comes from the Shopify page
// document. Wrap it in an element carrying `data-bars` (so the bars grow on
// scroll) — e.g. <div class="cro-viz" data-bars>.
//
// Bar widths are written only when there is a value. An absent one used to
// emit `--w:null`, and that is worse than it looks: the custom property *is*
// then defined, so the `var(--w, 100%)` fallback in global.css never fires and
// the width resets to `auto` — a silently full-width bar rather than the
// designed default.
import type { ShopifyPageContent } from '../lib/types';

interface Props {
  data: ShopifyPageContent['croDashboard'];
}
const { data } = Astro.props;
---
<div class="cro-card cro-uplift">
  <div>
    <span class="cro-k">{data.rateLabel}</span>
    <div class="cro-rate"><s>{data.rateBefore}</s><span class="cro-arrow">→</span><b>{data.rateAfter}</b></div>
  </div>
  <span class="cro-badge"><Icon name="fa-solid fa-arrow-trend-up" /> {data.rateBadge}</span>
</div>

<div class="cro-card cro-ab">
  <div class="cro-ab-head"><span>{data.abTitle}</span><span class="cro-live"><span class="d"></span> {data.abStatus}</span></div>
  {data.abVariants.map((v) => (
    <div class={`cro-ab-row ${v.winner ? 'win' : ''}`}>
      <div class="cro-ab-top">
        <span class="cro-ab-name">{v.name} {v.winner && v.winnerLabel && <em>{v.winnerLabel}</em>}</span>
        <b>{v.value}</b>
      </div>
      <div class="cro-ab-bar"><i class="bargrow" style={v.barWidth ? `width:${v.barWidth}` : undefined}></i></div>
    </div>
  ))}
  <div class="cro-ab-foot">{data.abFoot}</div>
</div>

<div class="cro-card cro-funnel">
  <span class="cro-k">{data.funnelLabel}</span>
  <div class="cro-fn">
    {data.funnel.map((r) => (
      <div class="cro-fn-row">
        <span>{r.step}</span>
        <div class="cro-fn-bar bargrow" style={r.barWidth ? `--w:${r.barWidth}` : undefined}></div>
        <b>{r.value}</b>
      </div>
    ))}
  </div>
</div>
