---
import type { SiteSettings } from '../lib/types';
interface Props { site: SiteSettings; onHome?: boolean; subpage?: boolean; }
const { site } = Astro.props;
const path = Astro.url.pathname;

// A tab is active when the path matches its `match` prefix (or its href).
// "/" only matches exactly, so it doesn't light up on every page.
const tabs = site.nav.map((t) => {
  const prefix = t.match || t.href.split('?')[0];
  return { ...t, active: prefix === '/' ? path === '/' : path.startsWith(prefix) };
});
---
<nav class="tabbar" id="nav" aria-label="Primary">
  <div class="tabbar-inner">
    {tabs.map((t) => (
      <a
        href={t.href}
        class={`tab ${t.active ? 'active' : ''}`}
        aria-current={t.active ? 'page' : undefined}
      >
        <i class={t.icon} aria-hidden="true"></i>
        <span>{t.label}</span>
      </a>
    ))}
  </div>
</nav>
