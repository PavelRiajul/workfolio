---
// A mockup of what each top-level service actually delivers. Shared by the
// home ServiceStack and the /services showcase. Sits on the same `.sv`
// wrapper as ServiceVisual so both share sizing, panels and shadows.
import type { Service } from '../lib/types';

interface Props {
  service: Service;
}
const { service: s } = Astro.props;
---
{s.visual === 'ai' && (
  <div class="sv">
    <div class="sv-panel ov-ai">
      <div class="ov-prompt">
        <span class="ov-caret">›</span>
        <span class="ov-typed">Add Stripe checkout with a 14-day trial</span>
      </div>
      <div class="ov-gen">
        <div class="ov-genrow"><i class="fa-solid fa-check" aria-hidden="true"></i>checkout/route.ts <em>generated</em></div>
        <div class="ov-genrow"><i class="fa-solid fa-check" aria-hidden="true"></i>billing.schema.ts <em>generated</em></div>
        <div class="ov-genrow"><i class="fa-solid fa-check" aria-hidden="true"></i>checkout.test.ts <em>8 passing</em></div>
        <div class="ov-genrow warn"><i class="fa-solid fa-pen" aria-hidden="true"></i>webhook retry logic <em>rewritten by me</em></div>
      </div>
      <div class="ov-foot"><span class="ov-dot"></span>Reviewed line by line before merge</div>
    </div>
    <div class="sv-cap">4 hours of typing, done in 6 minutes</div>
  </div>
)}

{s.visual === 'mvp' && (
  <div class="sv">
    <div class="sv-panel ov-mvp">
      <div class="ov-head"><b>MVP sprint</b><span class="ov-live"><i></i>Week 3 · live</span></div>
      <div class="ov-week"><em>Week 1</em><span class="ov-track"><i style="width:100%"></i></span><b>Scope &amp; schema</b></div>
      <div class="ov-week"><em>Week 2</em><span class="ov-track"><i style="width:100%"></i></span><b>Core loop</b></div>
      <div class="ov-week"><em>Week 3</em><span class="ov-track"><i style="width:78%"></i></span><b>Polish &amp; ship</b></div>
      <div class="ov-ship"><span>First real user</span><b>Day 19</b></div>
    </div>
    <div class="sv-cap">Weekly demo builds — not weekly status calls</div>
  </div>
)}

{s.visual === 'commerce' && (
  <div class="sv">
    <div class="sv-panel">
      <div class="sv-bar"><i></i><i></i><i></i><em>yourstore.com</em></div>
      <div class="ov-store">
        <div class="ov-tile"><span></span><b>$49</b></div>
        <div class="ov-tile"><span></span><b>$79</b></div>
        <div class="ov-tile"><span></span><b>$99</b></div>
      </div>
      <div class="ov-conv">
        <div class="ov-convrow"><em>Conversion rate</em><span><s>2.1%</s> → <b>3.4%</b></span></div>
        <div class="ov-track"><i style="width:86%"></i></div>
        <div class="ov-convrow"><em>Load time</em><span><s>4.2s</s> → <b>0.9s</b></span></div>
        <div class="ov-track"><i style="width:64%"></i></div>
      </div>
    </div>
    <div class="sv-cap">Built fast, then tested into converting</div>
  </div>
)}

{s.visual === 'booking' && (
  <div class="sv">
    <div class="sv-panel ov-book">
      <div class="ov-head"><b>WhatsApp</b><span class="ov-live"><i></i>Assistant</span></div>
      <div class="ov-chat">
        <span class="ov-msg in">Do you have anything Thursday morning?</span>
        <span class="ov-msg out">Dr. Rahman has 9:30 and 11:00 free. Which suits?</span>
        <span class="ov-msg in">9:30 please</span>
      </div>
      <div class="ov-booked">
        <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
        <span><b>Booked · Thu 9:30</b>Confirmation sent · clinic alerted</span>
      </div>
    </div>
    <div class="sv-cap">Real availability, checked before it answers</div>
  </div>
)}

{s.visual === 'api' && (
  <div class="sv">
    <div class="sv-panel ov-api">
      <div class="ov-head"><b>api.yourapp.com</b><span class="ov-ok">99.9% up</span></div>
      <div class="ov-ep"><span class="ov-m get">GET</span><code>/v1/orders</code><em>42ms</em></div>
      <div class="ov-ep"><span class="ov-m post">POST</span><code>/v1/orders</code><em>88ms</em></div>
      <div class="ov-ep"><span class="ov-m get">GET</span><code>/v1/users/:id</code><em>21ms</em></div>
      <div class="ov-chain">
        <span>Next.js</span><i>→</i><span>Node</span><i>→</i><span>MongoDB</span>
      </div>
    </div>
    <div class="sv-cap">Typed end to end — one source of truth</div>
  </div>
)}
