---
import Icon from './Icon.astro';
// A scroll-stacking glimpse of the top-level services. Cards pin and stack as
// you scroll (pure CSS sticky; GSAP adds a subtle settle-back scale).
// Each card pairs its copy with a mockup of what the service actually
// delivers. Full detail lives on /services.
import type { Cta, Heading, Service } from '../lib/types';
import OfferVisual from './OfferVisual.astro';
import Headline from './Headline.astro';

interface Props {
  services: Service[];
  heading: Heading;
  cta: Cta;
}
const { services, heading, cta } = Astro.props;
const headingLines = heading.title.split('\n');
// Keep the home glimpse tight — a few key features per card.
const PEEK = 4;
---
<section class="section section-bordered">
  <div class="sstack-head" data-reveal>
    <div>
      <div class="eyebrow">{heading.eyebrow}</div>
      <h2><Headline text={headingLines} /></h2>
    </div>
    <a href={cta.href} class="btn btn-light btn-sm">{cta.label}</a>
  </div>

  <div class="sstack" id="sstack">
    {services.map((s, i) => (
      <a
        href={s.href || `/services#${s.slug}`}
        class={`sstack-card tone-${s.tone}`}
        style={`--i:${i}`}
        aria-label={`${s.title} — see the full service`}
      >
        <span class="sstack-go" aria-hidden="true">↗</span>

        <div class="sstack-main">
          <span class="sstack-kicker">
            <Icon name={s.icon} />
            {s.kicker} · {s.number}
          </span>
          <h3>{s.title}</h3>
          <p class="sstack-lede">{s.tagline}</p>
          <div class="sstack-tags">
            {s.features.slice(0, PEEK).map((f) => <span class="sstack-tag">{f}</span>)}
            {s.features.length > PEEK && (
              <span class="sstack-tag more">+{s.features.length - PEEK} more</span>
            )}
          </div>
        </div>

        <div class="sstack-visual" aria-hidden="true">
          <OfferVisual service={s} />
        </div>
      </a>
    ))}
  </div>
</section>
