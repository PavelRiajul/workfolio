---
import type { Project, ShopifyProject } from '../lib/types';
interface Props { projects: (Project | ShopifyProject)[]; ctaLabel?: string; liveLabel?: string }
const { projects, ctaLabel = 'View full case study →', liveLabel = 'Visit live site ↗' } = Astro.props;

/* Build the modal lookup consumed by the script below.
   Takes either document type, because /shopify shows the same quick-look over
   `shopifyProject` documents. Those carry no dedicated modal copy, so the card
   blurb is the summary and the category stands in for the type — a Shopify
   project is described by the kind of build, not by a stack label.
   Both buttons are optional per project: `href` is empty when there is no case
   study (it used to fall back to "#", rendering a button that went nowhere)
   and `live` is empty until someone authors a URL. */
const modalData: Record<string, unknown> = {};
for (const p of projects) {
  const shopify = 'category' in p;
  const summary = shopify ? p.blurb : p.modalSummary;
  if (!summary) continue;
  modalData[p.slug] = {
    name: p.title,
    stack: p.stack,
    type: shopify ? (p.category?.label ?? '') : p.type,
    summary,
    outcomes: shopify ? [] : p.modalOutcomes.map((o) => [o.stat, o.label]),
    href: shopify
      ? (p.caseStudySlug ? `/work/${p.caseStudySlug}` : '')
      : (p.hasCaseStudy ? `/work/${p.slug}` : ''),
    live: p.liveUrl || '',
  };
}
---
<div class="pm-overlay" id="pm-overlay">
  <div
    class="pm-dialog"
    id="pm-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="pm-title"
    tabindex="-1"
  >
    <button class="pm-close" id="pm-close" aria-label="Close">✕</button>
    <div class="pm-eyebrow">Project</div>
    <h3 id="pm-title">Project</h3>
    <div id="pm-meta"></div>
    <p id="pm-summary"></p>
    <div id="pm-outcomes"></div>
    <div class="pm-actions">
      <a id="pm-link" class="pm-link" href="#">{ctaLabel}</a>
      <a
        id="pm-live"
        class="pm-link pm-link-ghost"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
      >{liveLabel}</a>
    </div>
  </div>
</div>
<script type="application/json" id="pm-data" set:html={JSON.stringify(modalData)}></script>

<script>
  // Navigation is client-side, so this module is evaluated once for the whole
  // session. `astro:page-load` fires on the first load and after every swap,
  // which re-binds this to the incoming page's modal markup.
  document.addEventListener('astro:page-load', () => {
    // Project modal — co-located with the component (Home + Work pages).
    interface ModalProject { name: string; stack: string; type: string; summary: string; outcomes: [string, string][]; href: string; live: string; }
    const overlay = document.getElementById('pm-overlay');
    const dataEl = document.getElementById('pm-data');
    if (overlay && dataEl) {
      let data: Record<string, ModalProject> = {};
      try { data = JSON.parse(dataEl.textContent || '{}'); } catch { data = {}; }
      const dialog = document.getElementById('pm-dialog');
      const closeBtn = document.getElementById('pm-close');
      // Elements that can hold keyboard focus, for the focus trap.
      const FOCUSABLE = 'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';
      const focusables = () =>
        [...(dialog?.querySelectorAll<HTMLElement>(FOCUSABLE) ?? [])].filter(
          (el) => el.offsetWidth > 0 || el.offsetHeight > 0 || el === document.activeElement
        );
      // Remember who opened the modal so focus can return there on close.
      let lastFocused: HTMLElement | null = null;
      const isOpen = () => overlay.classList.contains('open');
      const open = (p: ModalProject) => {
        (document.getElementById('pm-title') as HTMLElement).textContent = p.name;
        (document.getElementById('pm-meta') as HTMLElement).textContent = `${p.stack}  ·  ${p.type}`;
        (document.getElementById('pm-summary') as HTMLElement).textContent = p.summary;
        (document.getElementById('pm-outcomes') as HTMLElement).innerHTML = p.outcomes
          .map((o) => `<div><div class="out-num">${o[0]}</div><div class="out-lbl">${o[1]}</div></div>`)
          .join('');
        // Each button is shown only when this project has somewhere for it to
        // go. `hidden` rather than a class, so the focus trap — which filters
        // on rendered size — skips it too, and a keyboard user never lands on
        // a button that isn't there.
        const setLink = (id: string, url: string) => {
          const el = document.getElementById(id) as HTMLAnchorElement | null;
          if (!el) return;
          el.hidden = !url;
          if (url) el.setAttribute('href', url);
        };
        setLink('pm-link', p.href);
        setLink('pm-live', p.live);
        lastFocused = document.activeElement as HTMLElement | null;
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
        // Move focus into the dialog so keyboard users start inside it.
        (focusables()[0] ?? dialog)?.focus();
      };
      const close = () => {
        overlay.classList.remove('open');
        document.body.style.overflow = '';
        // Restore focus to the card (or whatever) that opened the modal.
        lastFocused?.focus?.();
        lastFocused = null;
      };
      document.querySelectorAll<HTMLElement>('.work-card[data-project]').forEach((card) => {
        card.addEventListener('click', (e) => {
          const id = card.dataset.project || '';
          const p = data[id];
          if (!p) return; // no modal data → follow the link
          e.preventDefault();
          open(p);
        });
      });
      overlay.addEventListener('click', close);
      dialog?.addEventListener('click', (e) => e.stopPropagation());
      closeBtn?.addEventListener('click', close);
      const onKey = (e: KeyboardEvent) => {
        if (!isOpen()) return;
        if (e.key === 'Escape') { close(); return; }
        if (e.key !== 'Tab') return;
        // Trap Tab/Shift+Tab so focus cycles inside the dialog, never behind it.
        const items = focusables();
        if (!items.length) { e.preventDefault(); return; }
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement as HTMLElement;
        const inside = dialog?.contains(active);
        if (e.shiftKey && (active === first || !inside)) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && (active === last || !inside)) { e.preventDefault(); first.focus(); }
      };
      // The trap has to sit on document to catch Tab from anywhere, which means
      // it is the one listener here that outlives the page — everything else is
      // bound to elements that get swapped out with it.
      document.addEventListener('keydown', onKey);
      document.addEventListener(
        'astro:before-swap',
        () => document.removeEventListener('keydown', onKey),
        { once: true }
      );
    }
  });
</script>
