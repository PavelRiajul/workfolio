---
import type { SiteSettings } from '../lib/types';
interface Props { site: SiteSettings; }
const { site } = Astro.props;
const phone = (site.whatsappPhone || '').replace(/[^0-9]/g, '');
const href = `https://wa.me/${phone}?text=${encodeURIComponent(site.whatsappMessage || '')}`;
---
<a class="wa-fab" href={href} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <svg class="wa-ring" viewBox="0 0 120 120">
    <defs>
      <path id="waTextCircle" d="M60,60 m-45,0 a45,45 0 1,1 90,0 a45,45 0 1,1 -90,0"></path>
    </defs>
    <text>
      <textPath href="#waTextCircle" startOffset="0" textLength="283" lengthAdjust="spacing">LET'S TALK ON WHATSAPP • OPEN TO WORK •</textPath>
    </text>
  </svg>
  <span class="wa-btn"><i class="fa-brands fa-whatsapp"></i></span>
</a>

<style is:global>
  .wa-fab { position: fixed; right: 22px; bottom: calc(var(--tabbar-h) + 16px); z-index: 1100; width: 104px; height: 104px; display: flex; align-items: center; justify-content: center; text-decoration: none; transition: opacity .3s ease, transform .3s ease; }
  /* Tuck away when the footer scrolls into view so it never covers footer content. */
  .wa-fab.wa-tuck { opacity: 0; transform: scale(0.6) translateY(12px); pointer-events: none; }
  .wa-ring { position: absolute; inset: 0; width: 100%; height: 100%; transform-origin: center; animation: waSpin 11s linear infinite; }
  .wa-ring text { font-family: var(--font-mono); font-size: 11px; font-weight: 500; fill: #1faf54; text-transform: uppercase; }
  .wa-btn { position: relative; width: 58px; height: 58px; border-radius: 9999px; background: #25d366; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 22px rgba(37,211,102,0.38); transition: transform .25s ease; animation: waPulse 2.6s ease-out infinite; }
  .wa-btn i { color: #fff; font-size: 30px; line-height: 1; }
  .wa-fab:hover .wa-btn { transform: scale(1.08); }
  .wa-fab:hover .wa-ring { animation-duration: 4s; }
  @keyframes waSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes waPulse { 0% { box-shadow: 0 0 0 0 rgba(37,211,102,0.45); } 70% { box-shadow: 0 0 0 14px rgba(37,211,102,0); } 100% { box-shadow: 0 0 0 0 rgba(37,211,102,0); } }
  /* On small screens drop the spinning ring entirely — just a compact tap target. */
  @media (max-width: 640px) {
    .wa-fab { right: 16px; bottom: calc(var(--tabbar-h) + 12px); width: 56px; height: 56px; }
    .wa-ring { display: none; }
    .wa-btn { width: 56px; height: 56px; }
    .wa-btn i { font-size: 28px; }
    /* Joins the chrome tuck (see initTabBar): on a 375px screen a permanent
       floating button covers real content — here it was sitting on top of a
       hero stat. Desktop keeps it visible at all times. */
    .wa-fab.tucked { opacity: 0; transform: scale(0.6) translateY(12px); pointer-events: none; }
  }
</style>
