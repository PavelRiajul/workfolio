---
// ============================================================================
// Mascot — a reusable animated SVG pet that adopts the host site's design system.
// MASCOT_DESCRIPTION: a small friendly blob pet with two big eyes.
// STATES: idle (default) · walking (on hover/focus) · jumping (click toggles).
// Pure inline SVG + CSS keyframes. JS only swaps state classes. No libraries.
//
// To reuse on another site: re-run the token detection, then edit ONLY the
// THEME block in the <style> below. Everything else is style-independent.
// ============================================================================
interface Props { state?: 'idle' | 'walking' | 'jumping'; }
const { state = 'idle' } = Astro.props;
---
<button
  class={`mascot ${state}`}
  id="mascot"
  type="button"
  data-state={state}
  aria-label="Blob mascot — hover to walk, click to jump"
>
  <span class="mascot-bubble" aria-hidden="true">let's ship!</span>
  <svg class="mascot-svg" viewBox="0 0 120 124" role="img" aria-hidden="true">
    <!-- ground shadow -->
    <ellipse class="m-shadow" cx="60" cy="112" rx="27" ry="5"></ellipse>

    <!-- legs sit BEHIND the body; each is its own group with a hip pivot -->
    <g class="m-leg m-leg-l"><rect x="44" y="80" width="11" height="24" rx="5.5"></rect></g>
    <g class="m-leg m-leg-r"><rect x="65" y="80" width="11" height="24" rx="5.5"></rect></g>

    <!-- body bobs/squashes; transform-origin anchored near the feet -->
    <g class="m-body">
      <path class="m-blob" d="M60 20 C80 20 96 35 96 58 C96 82 80 95 60 95 C40 95 24 82 24 58 C24 35 40 20 60 20 Z"></path>
      <g class="m-eye m-eye-l">
        <circle class="m-sclera" cx="49" cy="55" r="11"></circle>
        <circle class="m-pupil" cx="51" cy="57" r="5"></circle>
      </g>
      <g class="m-eye m-eye-r">
        <circle class="m-sclera" cx="76" cy="55" r="11"></circle>
        <circle class="m-pupil" cx="78" cy="57" r="5"></circle>
      </g>
      <path class="m-mouth" d="M53 73 Q60 80 67 73"></path>
    </g>
  </svg>
</button>

<style>
  .mascot {
    /* ===== THEME — detected from the host site's design system ==============
       Re-theme by editing ONLY this block. Values read the host's own CSS
       variables first, with portable fallbacks. ============================= */
    --m-accent:   var(--color-blue, #2563eb);          /* brand / primary  → body */
    --m-accent-2: #5e8e3e;                              /* secondary (unused fill, kept for reuse) */
    --m-fg:       var(--color-ink, #0a0a0a);            /* ink → pupils + mouth */
    --m-eye:      #ffffff;                              /* sclera */
    --m-surface:  var(--color-surface, #f4f4f5);        /* tooltip bg */
    --m-line:     rgba(10, 10, 10, 0.10);               /* thin border (site uses subtle borders) */
    --m-radius:   9999px;                               /* site pills are fully round */
    --m-shadow:   0 12px 26px -10px rgba(10, 10, 10, 0.28);   /* soft elevation (tooltip) */
    --m-drop:     drop-shadow(0 8px 9px rgba(10, 10, 10, 0.16)); /* soft body shadow */
    --m-stroke-w: 0;                                    /* flat/minimal site → no outline */
    --m-font:     var(--font-body, 'Inter', sans-serif);
    --m-ease:     cubic-bezier(.22, .61, .36, 1);       /* site's smooth ease */
    /* ====================================================================== */

    position: fixed;
    left: clamp(14px, 3vw, 22px);
    /* tuck into the bottom-left corner, just above the host's tab bar */
    bottom: calc(var(--tabbar-h, 0px) + 18px);
    z-index: 1095;
    width: clamp(64px, 7vw, 78px);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    /* no fill-mode: the entrance must release the transform so the journey
       (Web Animations API) can drive the mascot freely afterwards */
    animation: m-in .5s var(--m-ease);
  }
  .mascot:focus-visible { outline: none; }
  .mascot:focus-visible .m-blob { stroke: var(--m-accent); stroke-width: 2; }
  /* Decorative + desktop-only: the mobile bottom is busy (tab bar + FAB). */
  @media (max-width: 767px) { .mascot { display: none; } }

  .mascot-svg { width: 100%; height: auto; display: block; overflow: visible; filter: var(--m-drop); }

  /* ---- adopt the host palette / outline language ------------------------- */
  .m-blob   { fill: var(--m-accent); stroke: var(--m-fg); stroke-width: var(--m-stroke-w); }
  .m-sclera { fill: var(--m-eye); }
  .m-pupil  { fill: var(--m-fg); }
  .m-mouth  { fill: none; stroke: var(--m-fg); stroke-width: 2.4; stroke-linecap: round; opacity: .82; }
  .m-shadow { fill: rgba(10, 10, 10, 0.12); }

  /* per-element pivots — the key to natural limb motion */
  .m-body, .m-eye, .m-leg, .m-shadow { transform-box: fill-box; }
  .m-body  { transform-origin: 50% 100%; }   /* anchor bob/squash at the feet */
  .m-eye   { transform-origin: 50% 50%; }     /* blink from eye centre */
  .m-leg   { transform-origin: 50% 0%; }      /* swing from the hip */
  .m-shadow{ transform-origin: 50% 50%; }     /* shrinks/grows with height */
  .m-leg rect { fill: var(--m-accent); }

  /* tooltip — uses the host font, radius, surface + shadow ----------------- */
  .mascot-bubble {
    position: absolute;
    left: 50%; bottom: calc(100% + 8px);
    transform: translateX(-50%) translateY(4px) scale(.96);
    transform-origin: bottom center;
    white-space: nowrap;
    font-family: var(--m-font);
    font-size: 12.5px; font-weight: 500;
    color: var(--m-fg);
    background: var(--m-surface);
    border: 1px solid var(--m-line);
    border-radius: var(--m-radius);
    padding: 6px 13px;
    box-shadow: var(--m-shadow);
    opacity: 0; pointer-events: none;
    transition: opacity .22s var(--m-ease), transform .22s var(--m-ease);
  }
  .mascot:hover .mascot-bubble,
  .mascot:focus-visible .mascot-bubble { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }

  /* ---- eyes always blink (any state) ------------------------------------- */
  .m-eye { animation: m-blink 4.2s ease-in-out infinite; }
  .m-eye-r { animation-delay: .15s; }

  /* ===== IDLE — gentle breathing bob ===================================== */
  .mascot.idle .m-body { animation: m-breathe 3s ease-in-out infinite; }

  /* ===== WALKING — alternating legs + brisk bob ========================== */
  .mascot.walking .m-body { animation: m-walkbob .5s ease-in-out infinite; }
  .mascot.walking .m-leg-l { animation: m-step .5s ease-in-out infinite; }
  .mascot.walking .m-leg-r { animation: m-step .5s ease-in-out infinite; animation-delay: -.25s; }

  /* ===== JUMPING — one physical hop: anticipation → gravity arc → settle ==
     Each keyframe sets its OWN outgoing easing so the arc obeys gravity:
     decelerate on the way up, accelerate on the way down, hard squash on
     impact, then a damped secondary bounce. Plays ONCE per click. ========= */
  .mascot.jumping .m-body  { animation: m-jump 1s both; }
  .mascot.jumping .m-leg-l { animation: m-tuck 1s both; }
  .mascot.jumping .m-leg-r { animation: m-tuck 1s both; animation-delay: .03s; }
  .mascot.jumping .m-shadow{ animation: m-shadow 1s both; }

  @keyframes m-in     { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes m-breathe{ 0%, 100% { transform: translateY(0) scale(1); } 50% { transform: translateY(-3px) scale(1.03); } }
  @keyframes m-blink  { 0%, 90%, 100% { transform: scaleY(1); } 95% { transform: scaleY(.12); } }
  @keyframes m-walkbob{ 0%, 100% { transform: translateY(0) rotate(-1.5deg); } 50% { transform: translateY(-3px) rotate(1.5deg); } }
  @keyframes m-step   { 0%, 100% { transform: rotate(22deg); } 50% { transform: rotate(-22deg); } }

  @keyframes m-jump {
    0%   { transform: translateY(0)    scale(1, 1);     animation-timing-function: cubic-bezier(.34,.02,.7,.2); } /* settle → load */
    13%  { transform: translateY(7px)  scale(1.18, .8); animation-timing-function: cubic-bezier(.18,.85,.3,1); }  /* deep crouch, then explode up */
    32%  { transform: translateY(-34px) scale(.9, 1.14); animation-timing-function: cubic-bezier(.3,0,.55,.5); }  /* rising, decelerating (gravity) */
    45%  { transform: translateY(-40px) scale(.96, 1.06); animation-timing-function: cubic-bezier(.5,.4,.85,1); } /* apex hang → start falling */
    63%  { transform: translateY(0)    scale(1.22, .74); animation-timing-function: cubic-bezier(.2,.85,.35,1); } /* impact: hard squash */
    77%  { transform: translateY(-10px) scale(.98, 1.04); animation-timing-function: cubic-bezier(.3,0,.6,.5); }  /* damped secondary bounce */
    88%  { transform: translateY(0)    scale(1.09, .93); animation-timing-function: ease-out; }                   /* second, softer impact */
    95%  { transform: translateY(-2px) scale(1, 1); }                                                            /* micro settle */
    100% { transform: translateY(0)    scale(1, 1); }
  }
  @keyframes m-tuck {
    0%, 13%  { transform: translateY(0) rotate(0); }
    32%, 45% { transform: translateY(-9px) rotate(-10deg); } /* tuck up while airborne */
    63%      { transform: translateY(2px) rotate(7deg); }    /* splay out on landing */
    77%, 100%{ transform: translateY(0) rotate(0); }
  }
  @keyframes m-shadow {
    0%, 13% { transform: scale(1);    opacity: 1; }
    42%     { transform: scale(.66);  opacity: .5; }   /* small + faint when airborne */
    63%     { transform: scale(1.12); opacity: 1; }    /* spreads on impact */
    100%    { transform: scale(1);    opacity: 1; }
  }

  /* ===== Journey (homepage choreography) =================================
     While "busy", the WAAPI drives the .mascot's travel (translate); these
     classes drive the weighted body/leg poses via transitions, in sync with
     each phase. transform-origin stays at the feet, so squash reads as weight. */
  .mascot.busy { z-index: 1099; }
  .mascot.busy .mascot-bubble { opacity: 0 !important; }
  .mascot.busy .m-body { animation: none; transition: transform .2s var(--m-ease); }
  .mascot.busy .m-leg  { animation: none; transition: transform .2s var(--m-ease); }
  .mascot.busy.crouch  .m-body { transform: translateY(6px) scale(1.16, .82); } /* load */
  .mascot.busy.leaping .m-body { transform: scale(.9, 1.14); }                  /* stretch airborne */
  .mascot.busy.leaping .m-leg  { transform: translateY(-9px) rotate(-10deg); }  /* tuck */
  .mascot.busy.landing .m-body { transform: scale(1.22, .74); }                 /* impact squash */
  .mascot.busy.sliding .m-body { transform: rotate(-9deg) scale(1.02, .98); }   /* lean down the ramp */
  .mascot.busy.sliding .m-leg  { transform: rotate(14deg); }                    /* feet out front */
  /* face the direction of travel */
  .mascot-svg { transition: transform .2s ease; }
  .mascot.face-left .mascot-svg { transform: scaleX(-1); }

  /* ===== Reduced motion ==================================================
     Kill ambient loops (entrance, breathing, walking, blink) so the page is
     calm at rest — but KEEP the click-triggered jump: it's user-initiated and
     brief, which reduced-motion guidance permits. ========================= */
  @media (prefers-reduced-motion: reduce) {
    .mascot { animation: none; opacity: 1; }
    .mascot .m-eye,
    .mascot.idle .m-body,
    .mascot.walking .m-body,
    .mascot.walking .m-leg { animation: none !important; }
    .mascot-bubble { transition: opacity .01s; }
  }
</style>

<script>
  const m = document.getElementById('mascot') as HTMLElement | null;
  const body = m?.querySelector('.m-body') as SVGElement | null;
  if (m && body) {
    const STATES = ['idle', 'walking', 'jumping'];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
    let near = false;   // hovered / focused
    let busy = false;   // a journey is playing

    const set = (s: string) => {
      if (busy) return;
      m.classList.remove(...STATES);
      m.classList.add(s);
      m.dataset.state = s;
    };
    const isJumping = () => m.classList.contains('jumping');

    /* ---- fallback: one physical hop (reduced-motion / mobile / scrolled) -- */
    const jump = () => {
      m.classList.remove('jumping');
      void m.offsetWidth;
      set('jumping');
    };
    body.addEventListener('animationend', () => {
      if (!busy && isJumping()) set(near ? 'walking' : 'idle');
    });

    /* ---- journey: travel via the Web Animations API, baked per phase ------ */
    let offX = 0, offY = 0; // current translate offset from the home corner
    const bake = (a: Animation) => a.finished.then(() => { try { a.commitStyles(); } catch {} a.cancel(); });
    function leap(dx: number, dy: number, dur: number, arc: number) {
      const apexY = Math.min(offY, dy) - arc;
      const midX = offX + (dx - offX) * 0.5;
      const a = m!.animate(
        [
          { transform: `translate(${offX}px, ${offY}px)`, easing: 'cubic-bezier(.2,.5,.5,.85)' },
          { transform: `translate(${midX}px, ${apexY}px)`, offset: 0.5, easing: 'cubic-bezier(.4,.05,.75,1)' },
          { transform: `translate(${dx}px, ${dy}px)` },
        ],
        { duration: dur, fill: 'forwards' }
      );
      offX = dx; offY = dy;
      return bake(a);
    }
    function slide(dx: number, dy: number, dur: number) {
      const a = m!.animate(
        [
          { transform: `translate(${offX}px, ${offY}px)`, easing: 'cubic-bezier(.45,0,.55,1)' },
          { transform: `translate(${dx}px, ${dy}px)` },
        ],
        { duration: dur, fill: 'forwards' }
      );
      offX = dx; offY = dy;
      return bake(a);
    }

    // current untransformed home position (left/bottom are CSS-fixed):
    // current rect = home + offset, so home = rect - offset.
    function homePos() {
      const r = m!.getBoundingClientRect();
      return { cx: r.left + r.width / 2 - offX, feetY: r.bottom - offY };
    }
    const curX = () => homePos().cx + offX;            // current feet x in the viewport
    const face = (targetX: number) => m!.classList.toggle('face-left', targetX < curX());
    const onScreen = (el: Element | null) => {
      if (!el) return false;
      const r = el.getBoundingClientRect();
      return r.width > 0 && r.top >= 40 && r.bottom <= window.innerHeight - 80 && r.left >= 0 && r.right <= window.innerWidth;
    };
    const tabbar = () => parseInt(getComputedStyle(document.documentElement).getPropertyValue('--tabbar-h')) || 64;
    // looser than onScreen: the element's TOP edge just needs to be reachable
    // (so the pet can sit on top of tall cards that aren't fully in view).
    const landable = (el: Element | null) => {
      if (!el) return false;
      const r = el.getBoundingClientRect();
      return r.width > 30 && r.top >= 56 && r.top <= window.innerHeight - tabbar() - 90 && r.left >= 4 && r.right <= window.innerWidth - 4;
    };

    /* ---- behaviours ------------------------------------------------------ */
    const svg = m.querySelector('.mascot-svg') as SVGElement | null;
    // Playable elements across EVERY page/section (not just the hero).
    const PLAY = '.btn, .chip, .work-card, .post-card, .post-feature, .appr-card, .trait-card, .tst-card, .acc summary, .ft-soc, .brand-wall span, .cs-pill';
    const playables = () => [...document.querySelectorAll<HTMLElement>(PLAY)].filter((el) => el !== m && landable(el));

    // hop onto whatever is currently on screen; it dips under the weight
    async function interact(el: HTMLElement) {
      const h = homePos(); const r = el.getBoundingClientRect();
      const tx = r.left + r.width * (0.3 + Math.random() * 0.4);
      face(tx);
      if (Math.random() < 0.5) { m.classList.add('crouch'); await wait(120); m.classList.remove('crouch'); }
      m.classList.add('leaping');
      await leap(tx - h.cx, r.top - h.feetY, 500 + Math.random() * 340, 90 + Math.random() * 150);
      m.classList.remove('leaping'); m.classList.add('landing');
      el.classList.add('mascot-bonk');
      await wait(180); m.classList.remove('landing');
      el.classList.remove('mascot-bonk');
      if (Math.random() < 0.3) await spin();
      await wait(100 + Math.random() * 220);
    }

    // stay put but show personality: look around, double-bounce, or spin
    async function idleAct() {
      const k = Math.random();
      if (k < 0.4) {
        m.classList.toggle('face-left'); await wait(380);
        m.classList.toggle('face-left'); await wait(380);
      } else if (k < 0.74) {
        m.classList.add('leaping'); await leap(offX, offY, 300, 55); m.classList.remove('leaping');
        m.classList.add('landing'); await wait(110); m.classList.remove('landing');
        m.classList.add('leaping'); await leap(offX, offY, 250, 32); m.classList.remove('leaping');
        m.classList.add('landing'); await wait(110); m.classList.remove('landing');
      } else {
        await spin();
      }
    }

    async function spin() {
      if (!svg) return;
      m.classList.remove('face-left');
      await svg.animate(
        [{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }],
        { duration: 520, easing: 'cubic-bezier(.45,0,.45,1)' }
      ).finished;
    }
    async function playStack(stage: HTMLElement) {
      let h = homePos(); const r = stage.getBoundingClientRect();
      face(r.left + r.width * 0.42);
      m.classList.add('crouch'); await wait(140); m.classList.remove('crouch');
      m.classList.add('leaping');
      await leap(r.left + r.width * 0.42 - h.cx, r.top + r.height * 0.26 - h.feetY, 760, 175);
      m.classList.remove('leaping'); m.classList.add('landing');
      stage.dataset.locked = '1';
      stage.style.setProperty('--rx', '1deg');
      stage.style.setProperty('--ry', '-42deg');
      await wait(300); m.classList.remove('landing'); await wait(220);
      m.classList.add('sliding'); stage.style.setProperty('--rx', '22deg');
      h = homePos();
      const gx = 60 + Math.random() * (window.innerWidth * 0.45);
      const gy = window.innerHeight - tabbar() - (40 + Math.random() * 70);
      face(gx);
      await slide(gx - h.cx, gy - h.feetY, 840);
      m.classList.remove('sliding');
      stage.style.removeProperty('--rx'); stage.style.removeProperty('--ry');
      delete stage.dataset.locked;
    }
    async function wander() {
      const h = homePos();
      const tx = 50 + Math.random() * (window.innerWidth - 110);
      const ty = 140 + Math.random() * (window.innerHeight - 140 - tabbar() - 40);
      face(tx);
      m.classList.add('leaping');
      await leap(tx - h.cx, ty - h.feetY, 560 + Math.random() * 280, 80 + Math.random() * 130);
      m.classList.remove('leaping'); m.classList.add('landing');
      await wait(150); m.classList.remove('landing');
    }

    /* ---- the roam loop: auto-start, wander randomly, react to elements ---- */
    let roaming = false;
    const desktop = () => window.matchMedia('(min-width: 900px)').matches;

    async function step() {
      busy = true; m.classList.remove(...STATES); m.classList.add('busy');
      try {
        const stage = document.getElementById('hv-stage');
        const els = playables();
        const roll = Math.random();
        if (onScreen(stage) && roll < 0.18) await playStack(stage as HTMLElement); // hero-only special
        else if (els.length && roll < 0.62) await interact(els[(Math.random() * els.length) | 0]);
        else if (roll < 0.82) await wander();
        else await idleAct();
      } catch { /* keep roaming even if a phase hiccups */ }
      m.classList.remove('busy'); busy = false;
    }

    async function roam() {
      while (roaming) {
        set('idle');
        await wait(1100 + Math.random() * 2400);
        if (!roaming) break;
        if (busy || document.hidden || !desktop()) continue;
        await step();
      }
    }
    function startRoam() {
      if (roaming || reduce.matches || !desktop()) return;
      roaming = true;
      roam();
    }

    // auto-start a moment after load; pause/resume on viewport changes
    setTimeout(startRoam, 1600);
    window.addEventListener('resize', () => { if (desktop()) startRoam(); else roaming = false; });
    reduce.addEventListener?.('change', () => { if (reduce.matches) roaming = false; else startRoam(); });

    // click = an excited hop in place (works mid-roam idle and under reduced motion)
    m.addEventListener('click', () => { if (!busy) jump(); });
    m.addEventListener('mouseenter', () => { near = true; if (!busy && !isJumping()) set('walking'); });
    m.addEventListener('mouseleave', () => { near = false; if (!busy && !isJumping()) set('idle'); });
    m.addEventListener('focus', () => { near = true; if (!busy && !isJumping()) set('walking'); });
    m.addEventListener('blur', () => { near = false; if (!busy && !isJumping()) set('idle'); });
  }
</script>
