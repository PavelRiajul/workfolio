{
  "name": "workfolio",
  "type": "module",
  "version": "1.0.0",
  "description": "Riajul Islam — full-stack & Shopify developer portfolio. Astro + Tailwind + GSAP + Sanity.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "og": "node --experimental-strip-types scripts/og-images.mts",
    "seed:build": "node --experimental-strip-types scripts/seed-sanity.mts",
    "seed:import": "npm run schema:check && npm run seed:build && sanity dataset import sanity/seed.ndjson production --replace",
    "schema:check": "node --experimental-strip-types scripts/schema-drift.mts",
    "preschema:deploy": "npm run schema:check",
    "schema:deploy": "sanity schema deploy",
    "icons": "node --experimental-strip-types scripts/fetch-icons.mts",
    "webhook": "node --experimental-strip-types scripts/setup-webhook.mts",
    "blog:check": "node scripts/blog/anatomy-check.mjs",
    "blog:push": "node scripts/blog/push.mjs",
    "blog:queue": "node -e \"const q=require('./scripts/blog/queue.json');const left=Object.entries(q.remaining).filter(([,v])=>v.length);console.log(q.done.length+' published, '+left.reduce((a,[,v])=>a+v.length,0)+' remaining');console.log('next: '+q.current_category);for(const [c,v] of left)console.log('  '+c.padEnd(12)+v.length+'  '+v.slice(0,3).join(', '))\"",
    "seo:check": "node scripts/seo-check.mjs",
    "blog:benchmark": "node scripts/blog/benchmark.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^7.27.0",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "^3.68.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.3.1",
    "gsap": "^3.12.5",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanity": "^3.68.3",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.2"
  }
}
