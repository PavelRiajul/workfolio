# Sanity — copy this file to `.env` and fill in your project values.
# Leave PUBLIC_SANITY_PROJECT_ID as "placeholder" to run fully offline
# (the site serves the seeded fallback content baked into src/data).
#
# Create a project + get these at https://www.sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=placeholder
PUBLIC_SANITY_DATASET=production
